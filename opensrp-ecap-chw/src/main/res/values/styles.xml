<resources>

    <!-- Base application theme back to AppCompat to preserve legacy colors -->
    <style name="ChwTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/chw_primary</item>
        <item name="colorPrimaryDark">@color/chw_primary_dark</item>
        <item name="colorAccent">@color/chw_accent</item>
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
    </style>

    <!-- NoActionBar variant should inherit from ChwTheme -->
    <style name="ChwTheme.NoActionBar" parent="ChwTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="DrawerArrowStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">true</item>
        <item name="color">@android:color/white</item>
    </style>

    <style name="ChwFamilyTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/chw_family_primary</item>
        <item name="colorPrimaryDark">@color/chw_family_primary_dark</item>
        <item name="colorAccent">@color/chw_family_accent</item>
    </style>

    <style name="ChwFamilyTheme.NoActionBar" parent="ChwFamilyTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Base Family theme used by some library references (AppCompat) -->
    <style name="FamilyTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/chw_family_primary</item>
        <item name="colorPrimaryDark">@color/chw_family_primary_dark</item>
        <item name="colorAccent">@color/chw_family_accent</item>
    </style>

    <!-- NoActionBar variant that resizes content to fit screen (incl. keyboard) -->
    <style name="FamilyTheme.NoActionBar" parent="FamilyTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Ensure content resizes when keyboard appears and fits screen -->
        <item name="android:windowSoftInputMode">stateHidden|adjustResize</item>
        <!-- Use full available width on phones/tablets -->
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>


    <style name="ChwTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="ChwTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Login screen needs an ActionBar due to BaseLoginActivity usage -->
    <style name="ChwTheme.Login" parent="ChwTheme">
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:textSize">@dimen/login_font_size</item>
        <item name="colorControlActivated">@android:color/black</item>
        <!-- Ensure ActionBar is present for BaseLoginActivity -->
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <!-- Dedicated AppCompat theme for Login, in case BaseLoginActivity requires AppCompat specifically -->
    <style name="ChwTheme.AppCompatLogin" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/chw_primary</item>
        <item name="colorPrimaryDark">@color/chw_primary_dark</item>
        <item name="colorAccent">@color/chw_accent</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <style name="ChwTheme.AppBarOverlay.NavigationDrawerStyle">
        <item name="android:textSize">20sp</item>
        <!-- text size in menu-->
        <item name="android:listPreferredItemHeightSmall">70dp</item>
        <!-- item size in menu-->
    </style>

    <style name="ChwTheme.Dialog.FullWidth" parent="android:Theme.Holo.Light.Dialog">
        <item name="android:windowMinWidthMajor">98%</item>
        <item name="android:windowMinWidthMinor">98%</item>
        <item name="android:background">@android:color/white</item>
    </style>

    <style name="AppCompatAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:background">@color/grey</item>
    </style>

    <style name="copy_clipboard_dialog" parent="android:Theme.Holo.Dialog">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Define the referenced Material dialog checkbox style and a project-specific variant -->
    <style name="Material.Drawable.CheckBox.Dialog" parent="Widget.AppCompat.CompoundButton.CheckBox" />

    <style name="custom_chw_vaccine_checkbox" parent="Material.Drawable.CheckBox.Dialog">
        <item name="colorAccent">@android:color/white</item> <!-- for uncheck state -->
        <item name="android:textColorSecondary">@android:color/white</item>
    </style>
    <style name="FamilyTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:textColor">@color/black</item>
        <item name="colorBackgroundFloating">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
    </style>

    <style name="FamilyTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="FamilyTheme.AppBarOverlay.Light" parent="FamilyTheme.AppBarOverlay">
        <item name="android:textColorPrimary">@color/customAppThemeBlue</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Minimal fallback styles for OpenSRP custom font text appearances -->
    <style name="CustomFontTextViewStyle" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/black</item>
        <item name="fontVariant">regular</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList" parent="CustomFontTextViewStyle">
        <item name="fontVariant">regular</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Light" parent="CustomFontTextViewStyle.ClientList">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Medium" parent="CustomFontTextViewStyle.ClientList">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Bold" parent="CustomFontTextViewStyle.ClientList">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Black" parent="CustomFontTextViewStyle.ClientList">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.Header.Black" parent="TextAppearance.AppCompat.Headline">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.ListView.Normal.MultipleLines" parent="CustomFontTextViewStyle">
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CustomFontTextViewStyle.tabIndicator.sub.white" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.ThreeLines" parent="CustomFontTextViewStyle">
        <item name="fontVariant">regular</item>
        <item name="android:textColor">#737373</item>
        <item name="android:maxLines">3</item>
    </style>

    <!-- Minimal fallbacks used by core layouts -->
    <style name="CustomFontTextViewStyle.NavBar.Black" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.tabIndicator" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.ListView.Normal.Bold" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Light.twoline" parent="CustomFontTextViewStyle.ClientList.Light">
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Thin" parent="CustomFontTextViewStyle.ClientList">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#737373</item>
    </style>

    <!-- Additional fallbacks referenced by libraries -->
    <style name="CustomFontTextViewStyle.ClientList.NoPadding" parent="TextAppearance.AppCompat.Body1">
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.ListView.Medium" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="ReportFieldLabel" parent="TextAppearance.AppCompat.Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#737373</item>
        <item name="android:paddingTop">8dp</item>
    </style>

    <style name="ReportFieldValue" parent="TextAppearance.AppCompat.Body1">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- fragment_overview.xml section styles -->
    <style name="OverviewSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/overview_header_bg</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="OverviewRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:weightSum">2</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="OverviewRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="OverviewRowValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">start</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <!-- Read-only submitted-report screens (household/vca service report view) -->
    <style name="ReportSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_report_section_header</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:drawableStart">@drawable/ic_report_folder_24</item>
        <item name="android:drawableTint">@color/register_report_icon</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_black</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="OverviewChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_chip_subpop</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/register_vca_icon</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- FAB speed-dial rows: activity_household_details.xml -->
    <style name="HouseholdActionChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_household_action_chip</item>
        <item name="android:elevation">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HouseholdActionMiniFab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentRight">true</item>
        <item name="backgroundTint">@android:color/white</item>
        <item name="tint">@color/customAppThemeBlue</item>
        <item name="fabSize">mini</item>
    </style>

    <!-- FAB speed-dial rows: activity_mother_detail.xml, activity_mother_pmtct_detail.xml -->
    <style name="MotherActionChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_mother_action_chip</item>
        <item name="android:elevation">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MotherActionMiniFab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentRight">true</item>
        <item name="backgroundTint">@android:color/white</item>
        <item name="tint">@color/register_mother_icon</item>
        <item name="fabSize">mini</item>
    </style>

    <!-- FAB speed-dial rows: hts_profile.xml -->
    <style name="HtsActionChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_hts_action_chip</item>
        <item name="android:elevation">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HtsActionMiniFab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentRight">true</item>
        <item name="backgroundTint">@android:color/white</item>
        <item name="tint">@color/register_hts_icon</item>
        <item name="fabSize">mini</item>
    </style>

    <!-- FAB speed-dial rows: activity_hei_details.xml -->
    <style name="HeiActionChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_hei_action_chip</item>
        <item name="android:elevation">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HeiActionMiniFab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentRight">true</item>
        <item name="backgroundTint">@android:color/white</item>
        <item name="tint">@color/register_hei_header</item>
        <item name="fabSize">mini</item>
    </style>

</resources>
