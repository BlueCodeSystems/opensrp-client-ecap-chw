<resources>

    <!-- Base application theme. -->
    <style name="ChwTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/chw_primary</item>
        <item name="colorPrimaryDark">@color/chw_primary_dark</item>
        <item name="colorAccent">@color/chw_accent</item>
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
    </style>

    <style name="ChwTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="DrawerArrowStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">true</item>
        <item name="color">@android:color/white</item>
    </style>

    <style name="ChwFamilyTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/chw_family_primary</item>
        <item name="colorPrimaryDark">@color/chw_family_primary_dark</item>
        <item name="colorAccent">@color/chw_family_accent</item>
    </style>

    <style name="ChwFamilyTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Base Family theme used by some library references -->
    <style name="FamilyTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/chw_family_primary</item>
        <item name="colorPrimaryDark">@color/chw_family_primary_dark</item>
        <item name="colorAccent">@color/chw_family_accent</item>
    </style>


    <style name="ChwTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="ChwTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ChwTheme.Login" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:textSize">@dimen/login_font_size</item>
        <item name="colorControlActivated">@android:color/black</item>
    </style>

    <style name="ChwTheme.AppBarOverlay.NavigationDrawerStyle">
        <item name="android:textSize">20sp</item>
        <!-- text size in menu-->
        <item name="android:listPreferredItemHeightSmall">70dp</item>
        <!-- item size in menu-->
    </style>

    <style name="ChwTheme.Dialog.FullWidth" parent="android:Theme.Holo.Light.Dialog">
        <item name="android:windowMinWidthMajor">98%</item>
        <item name="android:windowMinWidthMinor">98%</item>
        <item name="android:background">@android:color/white</item>
    </style>

    <style name="AppCompatAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:background">@color/grey</item>
    </style>

    <style name="copy_clipboard_dialog" parent="android:Theme.Holo.Dialog">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Define the referenced Material dialog checkbox style and a project-specific variant -->
    <style name="Material.Drawable.CheckBox.Dialog" parent="Widget.AppCompat.CompoundButton.CheckBox" />

    <style name="custom_chw_vaccine_checkbox" parent="Material.Drawable.CheckBox.Dialog">
        <item name="colorAccent">@android:color/white</item> <!-- for uncheck state -->
        <item name="android:textColorSecondary">@android:color/white</item>
    </style>
    <style name="FamilyTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:textColor">@color/black</item>
        <item name="colorBackgroundFloating">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
    </style>

    <style name="FamilyTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="FamilyTheme.AppBarOverlay.Light" parent="FamilyTheme.AppBarOverlay">
        <item name="android:textColorPrimary">@color/customAppThemeBlue</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Minimal fallback styles for OpenSRP custom font text appearances -->
    <style name="CustomFontTextViewStyle" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/black</item>
        <item name="fontVariant">regular</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList" parent="CustomFontTextViewStyle">
        <item name="fontVariant">regular</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Light" parent="CustomFontTextViewStyle.ClientList">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Medium" parent="CustomFontTextViewStyle.ClientList">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Bold" parent="CustomFontTextViewStyle.ClientList">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Black" parent="CustomFontTextViewStyle.ClientList">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.Header.Black" parent="TextAppearance.AppCompat.Headline">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.ListView.Normal.MultipleLines" parent="CustomFontTextViewStyle">
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CustomFontTextViewStyle.tabIndicator.sub.white" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.ThreeLines" parent="CustomFontTextViewStyle">
        <item name="fontVariant">regular</item>
        <item name="android:textColor">#737373</item>
        <item name="android:maxLines">3</item>
    </style>

    <!-- Minimal fallbacks used by core layouts -->
    <style name="CustomFontTextViewStyle.NavBar.Black" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.tabIndicator" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.ListView.Normal.Bold" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Light.twoline" parent="CustomFontTextViewStyle.ClientList.Light">
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CustomFontTextViewStyle.ClientList.Thin" parent="CustomFontTextViewStyle.ClientList">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#737373</item>
    </style>

    <!-- Additional fallbacks referenced by libraries -->
    <style name="CustomFontTextViewStyle.ClientList.NoPadding" parent="TextAppearance.AppCompat.Body1">
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomFontTextViewStyle.ListView.Medium" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

</resources>
