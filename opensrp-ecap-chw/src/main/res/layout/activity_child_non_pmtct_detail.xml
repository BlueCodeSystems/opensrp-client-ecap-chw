<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".activity.ChildNonPmtctDetail">

    <RelativeLayout
        android:id="@+id/activity_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- APP BAR + CHILD PROFILE HEADER -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/collapsing_toolbar_appbarlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_vca_header_gradient"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:elevation="4dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:contentScrim="@color/register_vca_header"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:titleEnabled="false">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbarx"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:layout_collapseMode="pin"
                    app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

                <!-- Child profile header area -->
                <LinearLayout
                    android:id="@+id/profile_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="1.5">

                    <!-- Card-style child profile block -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/child_profile_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="3dp"
                        app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <!-- Top row: label + status -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/child_profile_label"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:alpha="0.7"
                                    android:letterSpacing="0.08"
                                    android:text="child_details"
                                    android:textAllCaps="true"
                                    android:textColor="@color/text_black"
                                    android:textSize="11sp" />

                                <!-- Case status pill (e.g. Active / Inactive / Closed) -->
                                <TextView
                                    android:id="@+id/child_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_chip_success"
                                    android:paddingStart="8dp"
                                    android:visibility="gone"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="2dp"
                                    android:singleLine="true"
                                    android:text=""
                                    android:textColor="@android:color/white"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Row: avatar + main info -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- Circular avatar: gender icon set dynamically in code (boy/girl/unknown) -->
                                <ImageView
                                    android:id="@+id/child_avatar"
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:layout_marginEnd="12dp"
                                    android:background="@drawable/bg_vca_icon_circle"
                                    android:padding="6dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/ic_child_unknown_gender" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <!-- Name -->
                                    <org.smartregister.view.customcontrols.CustomFontTextView
                                        android:id="@+id/child_name"
                                        style="@style/CustomFontTextViewStyle.ClientList.Medium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:maxLines="1"
                                        android:ellipsize="end"
                                        android:textColor="@color/text_black"
                                        android:textSize="@dimen/activity_title_size" />

                                    <!-- Age + gender + CA ID -->
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:orientation="horizontal">

                                        <!-- Age -->
                                        <org.smartregister.view.customcontrols.CustomFontTextView
                                            android:id="@+id/child_age"
                                            style="@style/CustomFontTextViewStyle.ClientList.Light"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="8 yrs"
                                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                            android:textColor="@color/light_grey_text" />

                                        <!-- Dot -->
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="6dp"
                                            android:layout_marginEnd="6dp"
                                            android:alpha="0.5"
                                            android:text="•"
                                            android:textColor="@color/light_grey_text" />

                                        <!-- Gender -->
                                        <org.smartregister.view.customcontrols.CustomFontTextView
                                            android:id="@+id/child_gender"
                                            style="@style/CustomFontTextViewStyle.ClientList.Light"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Male"
                                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                            android:textColor="@color/light_grey_text" />

                                        <!-- Dot -->
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="6dp"
                                            android:layout_marginEnd="6dp"
                                            android:alpha="0.5"
                                            android:text="•"
                                            android:textColor="@color/light_grey_text" />

                                        <!-- CA ID -->
                                        <org.smartregister.view.customcontrols.CustomFontTextView
                                            android:id="@+id/child_id"
                                            style="@style/CustomFontTextViewStyle.ClientList.Light"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="CA ID: 123456"
                                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                            android:textColor="@color/light_grey_text" />
                                    </LinearLayout>

                                    <!-- Household + caregiver -->
                                    <org.smartregister.view.customcontrols.CustomFontTextView
                                        android:id="@+id/child_household"
                                        style="@style/CustomFontTextViewStyle.ClientList.Light"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:maxLines="1"
                                        android:ellipsize="end"
                                        android:text="HH: HH-0001 • Caregiver: M. Banda"
                                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                        android:textColor="@color/light_grey_text" />

                                    <!-- Facility + ward/district -->
                                    <org.smartregister.view.customcontrols.CustomFontTextView
                                        android:id="@+id/child_facility"
                                        style="@style/CustomFontTextViewStyle.ClientList.Light"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:maxLines="1"
                                        android:ellipsize="end"
                                        android:text="Kanyama Clinic • Ward 3 • Lusaka"
                                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                        android:textColor="@color/light_grey_text" />

                                </LinearLayout>
                            </LinearLayout>

                            <!-- Quick link to mother profile -->
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_open_mother_profile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_button_vca_outline"
                                android:onClick="onClick"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:text="Open Mother Profile"
                                android:textAllCaps="false"
                                android:textColor="@color/register_vca_icon"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/register_vca_header"
                app:tabContentStart="0dp"
                app:tabGravity="fill"
                app:tabIndicatorColor="@android:color/white"
                app:tabIndicatorHeight="3dp"
                app:tabMaxWidth="0dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="@color/white"
                app:tabTextAppearance="@style/CustomFontTextViewStyle.tabIndicator.sub.white" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- MAIN CONTENT -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/collapsing_toolbar_appbarlayout"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- Dim scrim shown behind the open FAB menu -->
        <View
            android:id="@+id/fab_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- MENU BAR: child actions -->
        <LinearLayout
            android:id="@+id/menu_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/fabx"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/child_postnatal_care"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <TextView
                    style="@style/VcaActionChip"
                    android:layout_toStartOf="@+id/child_postnatal_care_fab"
                    android:text="@string/child_postnatal_care" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/child_postnatal_care_fab"
                    style="@style/VcaActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/child_longitudinal_follow_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <TextView
                    style="@style/VcaActionChip"
                    android:layout_toStartOf="@+id/child_longitudinal_follow_up_fab"
                    android:text="@string/child_longitudinal_follow_up" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/child_longitudinal_follow_up_fab"
                    style="@style/VcaActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/child_final_outcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <TextView
                    style="@style/VcaActionChip"
                    android:layout_toStartOf="@+id/child_final_outcome_fab"
                    android:text="@string/child_final_outcome" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/child_final_outcome_fab"
                    style="@style/VcaActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

        </LinearLayout>

        <!-- MAIN FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:onClick="onClick"
            android:tint="@android:color/white"
            app:backgroundTint="@color/register_vca_icon"
            app:fabSize="normal"
            app:srcCompat="@drawable/baseline_mode_edit_24" />

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
