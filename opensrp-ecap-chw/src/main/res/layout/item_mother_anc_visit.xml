<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_mother_icon_circle"
                android:contentDescription="@string/not_available"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_calender"
                app:tint="@color/register_mother_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDateFirstVisit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="12 Aug 2025"
                    android:textColor="@color/text_black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtGestationWeeks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_report_chip"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Gestation: 16 weeks"
                    android:textColor="@color/register_mother_icon"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/expand_more"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/not_available"
                android:padding="4dp"
                android:src="@drawable/baseline_expand_more_24"
                android:visibility="visible"
                app:tint="@color/light_grey_text" />

            <ImageView
                android:id="@+id/expand_less"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/not_available"
                android:padding="4dp"
                android:src="@drawable/baseline_expand_less_24"
                android:visibility="gone"
                app:tint="@color/light_grey_text" />

        </LinearLayout>

        <!-- DETAILS -->
        <LinearLayout
            android:id="@+id/details_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="HIV Status" />
                <TextView
                    android:id="@+id/txtHivTestSummary"
                    style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="Partner HIV Status" />
                <TextView
                    android:id="@+id/txtMaleHivTestSummary"
                    style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="Gravida / Parity" />
                <TextView
                    android:id="@+id/txtGravidaParity"
                    style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="TT Previous Doses" />
                <TextView
                    android:id="@+id/txtTtPreviousDoses"
                    style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="LMP" />
                <TextView
                    android:id="@+id/txtLmpDate"
                    style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="EDD" />
                <TextView
                    android:id="@+id/txtEddDate"
                    style="@style/OverviewRowValue" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider_grey" />

        <!-- ACTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/edit"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/edit"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
