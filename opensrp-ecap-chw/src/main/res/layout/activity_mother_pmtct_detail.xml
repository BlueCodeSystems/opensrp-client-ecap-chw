<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.HouseholdDetails"
    android:background="@color/dash_bg">


        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/collapsing_toolbar_appbarlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/profile_pmtct_header"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:elevation="4dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/profile_pmtct_header"
                app:contentScrim="@color/profile_pmtct_header"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbarx"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                    app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

                <LinearLayout
                    android:id="@+id/profile_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/actionBarSize"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="1.5">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/profile_household_avatar">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_mother_child"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/mother_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Hope Chanda"
                        android:textColor="@android:color/white"
                        android:textSize="24sp" />

                    <!-- Programme, status and age as pills -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/ProfileHeaderPill"
                            android:background="@drawable/profile_status_pill"
                            android:text="PMTCT"
                            android:textColor="@color/profile_pmtct_header" />

                        <TextView
                            style="@style/ProfileHeaderPill"
                            android:layout_marginStart="8dp"
                            android:text="Active care" />

                        <TextView
                            android:id="@+id/mother_age"
                            style="@style/ProfileHeaderPill"
                            android:layout_marginStart="8dp"
                            android:text="25" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/profile_buttons_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="18dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/mother_prof"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/profile_header_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:onClick="onClick"
                            android:paddingStart="@dimen/profile_btn_registration_info_padding"
                            android:paddingTop="9dp"
                            android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                            android:paddingBottom="9dp"
                            android:text="Mother Profile"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/hh_prof"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/profile_header_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:onClick="onClick"
                            android:paddingStart="@dimen/profile_btn_registration_info_padding"
                            android:paddingTop="9dp"
                            android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                            android:paddingBottom="9dp"
                            android:text="Household Profile"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <!-- Tabs on a white strip, divided from the records below -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                app:tabContentStart="0dp"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/profile_pmtct_header"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="3dp"
                app:tabMaxWidth="0dp"
                app:tabMode="scrollable"
                app:tabRippleColor="@color/dash_divider"
                app:tabSelectedTextColor="@color/dash_text"
                app:tabTextAppearance="@style/CustomFontTextViewStyle.tabIndicator.sub.white"
                app:tabTextColor="@color/dash_text_secondary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dash_divider" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Pager content -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Overlay for the action menu; a direct sibling so the header can collapse as the tabs scroll -->
    <RelativeLayout
        android:id="@+id/activity_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/fab_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <!-- Right-side vertical quick-actions menu (unchanged) -->
        <LinearLayout
            android:id="@+id/menu_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/fabx"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/mother_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/callFab3"
                    style="@style/MotherActionChip">

                    <TextView
                        android:id="@+id/add_mother"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Mother" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFab3"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@drawable/baseline_mode_edit_24" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/anc_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/callFabAnc"
                    style="@style/MotherActionChip">

                    <TextView
                        android:id="@+id/add_anc_detalis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ANC Details" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFabAnc"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/labour_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/callFabLabour"
                    style="@style/MotherActionChip">

                    <TextView
                        android:id="@+id/add_labour_detalis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Labour and Delivery" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFabLabour"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/child_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/callFab2"
                    style="@style/MotherActionChip">

                    <TextView
                        android:id="@+id/add_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Child" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFab2"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/postnatal_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/callFabPostnatal"
                    style="@style/MotherActionChip">

                    <TextView
                        android:id="@+id/add_postnatal_detalis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Postnatal Care" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFabPostnatal"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:onClick="onClick"
            android:tint="@android:color/white"
            android:visibility="gone"
            app:backgroundTint="#188038"
            app:fabSize="normal"
            app:srcCompat="@drawable/baseline_mode_edit_24" />

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
