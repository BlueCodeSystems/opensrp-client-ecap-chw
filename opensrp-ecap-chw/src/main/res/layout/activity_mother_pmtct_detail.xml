<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.HouseholdDetails"
    android:background="@android:color/white">

    <RelativeLayout
        android:id="@+id/activity_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/collapsing_toolbar_appbarlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/register_pmtct_header"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:elevation="3dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/register_pmtct_header"
                app:contentScrim="@color/register_pmtct_header"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:titleEnabled="false">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbarx"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@color/register_pmtct_header"
                    app:layout_collapseMode="pin"
                    app:theme="@style/ThemeOverlay.AppCompat.Light" />

                <LinearLayout
                    android:id="@+id/profile_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/actionBarSize"
                    android:background="@color/register_pmtct_header"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.7">

                    <org.smartregister.view.customcontrols.CustomFontTextView
                        android:id="@+id/mother_name"
                        style="@style/CustomFontTextViewStyle.ClientList.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Hope Chanda"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Hope Chanda" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            style="@style/CustomFontTextViewStyle.ClientList.Light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Age: "
                            android:textColor="@color/register_pmtct_header_light"
                            android:textSize="14sp" />

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            android:id="@+id/mother_age"
                            style="@style/CustomFontTextViewStyle.ClientList.Light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25"
                            android:textColor="@color/register_pmtct_header_light"
                            android:textSize="14sp"
                            tools:text="28" />
                    </LinearLayout>

                    <!-- Programme badge chips -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/register_pmtct_icon"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp"
                            android:text="PMTCT"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@color/register_pmtct_accent_light"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp"
                            android:text="Active Care"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/profile_buttons_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/mother_prof"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/transparent_white_button"
                            android:gravity="center"
                            android:onClick="onClick"
                            android:paddingStart="@dimen/profile_btn_registration_info_padding"
                            android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                            android:text="Mother Profile"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/hh_prof"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/transparent_white_button"
                            android:gravity="center"
                            android:onClick="onClick"
                            android:paddingStart="@dimen/profile_btn_registration_info_padding"
                            android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                            android:text="Household Profile"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/register_pmtct_icon"
                app:tabContentStart="0dp"
                app:tabGravity="fill"
                app:tabIndicatorColor="@android:color/white"
                app:tabIndicatorHeight="3dp"
                app:tabMaxWidth="0dp"
                app:tabMode="fixed"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@android:color/white"
                app:tabTextAppearance="@style/CustomFontTextViewStyle.tabIndicator.sub.white"
                app:tabTextColor="@color/register_pmtct_header_light" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Pager content -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/collapsing_toolbar_appbarlayout"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <View
            android:id="@+id/fab_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <!-- Right-side vertical quick-actions menu (unchanged) -->
        <LinearLayout
            android:id="@+id/menu_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/fabx"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/mother_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/callFab3"
                    style="@style/MotherActionChip">

                    <TextView
                        android:id="@+id/add_mother"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Mother" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFab3"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@drawable/baseline_mode_edit_24" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/anc_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/callFabAnc"
                    style="@style/MotherActionChip">

                    <TextView
                        android:id="@+id/add_anc_detalis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ANC Details" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFabAnc"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/labour_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/callFabLabour"
                    style="@style/MotherActionChip">

                    <TextView
                        android:id="@+id/add_labour_detalis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Labour and Delivery" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFabLabour"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/child_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/callFab2"
                    style="@style/MotherActionChip">

                    <TextView
                        android:id="@+id/add_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Child" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFab2"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/postnatal_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/callFabPostnatal"
                    style="@style/MotherActionChip">

                    <TextView
                        android:id="@+id/add_postnatal_detalis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Postnatal Care" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFabPostnatal"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:onClick="onClick"
            android:tint="@android:color/white"
            android:visibility="gone"
            app:backgroundTint="#0F4C81"
            app:fabSize="normal"
            app:srcCompat="@drawable/baseline_mode_edit_24" />

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
