<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.HouseholdDetails"
    android:background="@android:color/white">

    <RelativeLayout
        android:id="@+id/activity_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/collapsing_toolbar_appbarlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#6CB1A1"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:elevation="4dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#739273"
                app:contentScrim="#D6E9D6"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:titleEnabled="false">

                <!-- Toolbar stays on its own (pinned), not blended with header -->
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbarx"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"

                    app:layout_collapseMode="pin"
                    android:background="@drawable/bg_profile_header_gradient"
                    app:theme="@style/ThemeOverlay.AppCompat.Light" />

                <!-- Header starts BELOW the toolbar -->
                <LinearLayout
                    android:id="@+id/profile_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/actionBarSize"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="0dp"
                    android:paddingBottom="16dp"
                    android:background="@drawable/bg_profile_header_gradient"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.7">

                    <org.smartregister.view.customcontrols.CustomFontTextView
                        android:id="@+id/mother_name"
                        style="@style/CustomFontTextViewStyle.ClientList.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Hope Chanda"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/activity_title_size"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Hope Chanda" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            style="@style/CustomFontTextViewStyle.ClientList.Light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Age: "
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            android:id="@+id/mother_age"
                            style="@style/CustomFontTextViewStyle.ClientList.Light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text="28" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/profile_buttons_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/mother_prof"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/transparent_white_button"
                            android:gravity="center"
                            android:onClick="onClick"
                            android:paddingStart="@dimen/profile_btn_registration_info_padding"
                            android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                            android:text="Mother Profile"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/hh_prof"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/transparent_white_button"
                            android:gravity="center"
                            android:onClick="onClick"
                            android:paddingStart="@dimen/profile_btn_registration_info_padding"
                            android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                            android:text="Household Profile"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <!-- Tabs (use MotherDetail styling) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#447599"
                app:tabContentStart="0dp"
                app:tabGravity="fill"
                app:tabIndicatorColor="#E2E363"
                app:tabIndicatorHeight="4dp"
                app:tabMaxWidth="0dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="@color/white"
                app:tabTextAppearance="@style/CustomFontTextViewStyle.tabIndicator.sub.white" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Pager content -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/collapsing_toolbar_appbarlayout"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- Right-side vertical quick-actions menu (unchanged) -->
        <LinearLayout
            android:id="@+id/menu_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/fabx"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/mother_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/callFab3"
                    android:background="@drawable/bg_mother_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/add_mother"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Mother"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFab3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/baseline_mode_edit_24" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/anc_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/callFabAnc"
                    android:background="@drawable/bg_mother_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/add_anc_detalis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ANC Details"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFabAnc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/labour_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/callFabLabour"
                    android:background="@drawable/bg_mother_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/add_labour_detalis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Labour and Delivery"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFabLabour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/child_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/callFab2"
                    android:background="@drawable/bg_mother_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/add_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Child"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFab2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/postnatal_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/callFabPostnatal"
                    android:background="@drawable/bg_mother_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/add_postnatal_detalis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Postnatal Care"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFabPostnatal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add" />
            </RelativeLayout>

        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:onClick="onClick"
            android:tint="@android:color/white"
            app:backgroundTint="@color/text_black"
            app:fabSize="normal"
            app:srcCompat="@drawable/baseline_mode_edit_24" />

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
