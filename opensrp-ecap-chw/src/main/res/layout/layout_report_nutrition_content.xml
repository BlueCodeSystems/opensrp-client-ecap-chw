<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:viewBindingIgnore="true">

    <!-- Section A -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/section_a_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Section A: Children Under 5 Years by Sub-population"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/baseline_expand_more_24" />

            <TableLayout
                android:id="@+id/table_section_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_table_row"
                android:stretchColumns="1"
                android:visibility="gone">

                <TableRow android:background="@drawable/bg_table_header" android:paddingVertical="10dp">
                    <TextView android:text="Sub-population" android:textStyle="bold" android:paddingStart="12dp" android:textColor="@color/text_black"/>
                    <TextView android:text="Count" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_black"/>
                </TableRow>

                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="C/ALHIV" android:paddingStart="12dp"/>
                    <TextView android:id="@+id/subpop_calhiv" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="HEI" android:paddingStart="12dp"/>
                    <TextView android:id="@+id/subpop_hei" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="CML+HIV" android:paddingStart="12dp"/>
                    <TextView android:id="@+id/subpop_cml_hiv" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="C/PBFA" android:paddingStart="12dp"/>
                    <TextView android:id="@+id/subpop_cpbfa" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Siblings" android:paddingStart="12dp"/>
                    <TextView android:id="@+id/subpop_siblings" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section B -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/section_b_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Section B: Household Malnutrition Prevention (YTD)"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/baseline_expand_more_24" />

            <TableLayout
                android:id="@+id/table_section_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:visibility="gone">

                <TableRow android:background="@drawable/bg_table_header" android:paddingVertical="10dp">
                    <TextView android:text="Indicator" android:textStyle="bold" android:paddingStart="12dp" android:textColor="@color/text_black"/>
                    <TextView android:text="Value" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_black"/>
                </TableRow>

                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="HH Practicing Diet Diversity" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/hh_practicing_diet_diversity" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="HH Practicing Exclusive BF" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/hh_practicing_exclusive_bf" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="HH Practicing Complementary Feeding" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/hh_practicing_complementary_feeding" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="HH WASH Activities" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/hh_wash_activities" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="HH Visited for Assessment" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/hh_visited_assessment" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="PPMAM Identified" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/ppmam_identified" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="PPMAM Referred/Commenced Feeding" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/ppmam_referred_commenced" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Other Children in HH in PMAM" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/other_children_pmam" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="PLW on ART/PMTCT with Assessment" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/plw_art_pmtct_nutrition_assessment" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="PLW Received IFAS" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/plw_received_ifas" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Food Insecurity Counselled" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/hh_food_insecurity_counselled" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section C -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/section_c_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Section C: Micronutrient &amp; MNP Provision (MNP/VITA)"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/baseline_expand_more_24" />

            <TableLayout
                android:id="@+id/table_section_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:visibility="gone">

                <TableRow android:background="@drawable/bg_table_header" android:paddingVertical="10dp">
                    <TextView android:text="Indicator" android:textStyle="bold" android:paddingStart="12dp" android:textColor="@color/text_black"/>
                    <TextView android:text="Value" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_black"/>
                </TableRow>

                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Children 6-23 Months Received MNP" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/mnp_children_6_23_received" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="PLW Received MNP" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/mnp_plw_received" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Children Vitamin A (6-11 Months)" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/vita_children_6_11_months" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Children Vitamin A (12-59 Months)" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/vita_children_12_59_months" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="PLW Vitamin A (Post-Partum)" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/vita_plw_supplemented" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Children 12-59 Months Dewormed" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/deworming_children_12_59" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="PLW Dewormed" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/deworming_plw" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section D -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/section_d_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Section D: Early Childhood Development (YTD)"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/baseline_expand_more_24" />

            <TableLayout
                android:id="@+id/table_section_d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:visibility="gone">

                <TableRow android:background="@drawable/bg_table_header" android:paddingVertical="10dp">
                    <TextView android:text="Indicator" android:textStyle="bold" android:paddingStart="12dp" android:textColor="@color/text_black"/>
                    <TextView android:text="Value" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_black"/>
                </TableRow>

                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="ECD Centres Supported Monitoring" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/ecd_centres_supported_monitoring" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="ECD Centres with Feeding" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/ecd_centres_with_feeding" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Children Enrolled in ECD" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/ecd_children_enrolled" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Caregivers Trained Stimulation" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/ecd_caregivers_trained" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Developmental Screening Completed" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/ecd_developmental_screening" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section E -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/section_e_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Section E: Weight-For-Age Assessment"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/baseline_expand_more_24" />

            <TableLayout
                android:id="@+id/table_section_e"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:visibility="gone">

                <TableRow android:background="@drawable/bg_table_header" android:paddingVertical="10dp">
                    <TextView android:text="Category" android:textStyle="bold" android:paddingStart="12dp" android:textColor="@color/text_black"/>
                    <TextView android:text="Count" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_black"/>
                </TableRow>

                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="WFA: Underweight" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/wfa_underweight" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="WFA: Overweight" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/wfa_overweight" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="WFA: Normal" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/wfa_normal" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section F -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/section_f_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Section F: Nutrition Assessment - Children Below 5 Years (YTD)"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/baseline_expand_more_24" />

            <TableLayout
                android:id="@+id/table_section_f"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:visibility="gone">

                <TableRow android:background="@drawable/bg_table_header" android:paddingVertical="10dp">
                    <TextView android:text="Grade" android:textStyle="bold" android:paddingStart="12dp" android:textColor="@color/text_black"/>
                    <TextView android:text="Count" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_black"/>
                </TableRow>

                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Grade 1 (Moderate Malnutrition)" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/nutrition_grade_1" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Grade 2 (Severe Malnutrition)" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/nutrition_grade_2" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="NR (No Result)" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/nutrition_nr" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section G -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/section_g_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Section G: MUAC Measurements (Centimeters)"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/baseline_expand_more_24" />

            <TableLayout
                android:id="@+id/table_section_g"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:visibility="gone">

                <TableRow android:background="@drawable/bg_table_header" android:paddingVertical="10dp">
                    <TextView android:text="MUAC Category" android:textStyle="bold" android:paddingStart="12dp" android:textColor="@color/text_black"/>
                    <TextView android:text="Count" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_black"/>
                </TableRow>

                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Red (&lt; 11.5 cm) - SAM" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/muac_red_below_11_5" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Yellow (11.5 - &lt;12.5 cm) - MAM" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/muac_yellow_11_5_to_12_5" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Green (&gt;= 12.5 cm) - Normal" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/muac_green_12_5_plus" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="With Oedema" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/muac_oedema" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section H -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/section_h_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Section H: STI"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/baseline_expand_more_24" />

            <TableLayout
                android:id="@+id/table_section_h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:visibility="gone">

                <TableRow android:background="@drawable/bg_table_header" android:paddingVertical="10dp">
                    <TextView android:text="STI Indicator" android:textStyle="bold" android:paddingStart="12dp" android:textColor="@color/text_black"/>
                    <TextView android:text="Count" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_black"/>
                </TableRow>

                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="STI Cases Referred" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/sti_referred" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="STI Cases Treated" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/sti_treated" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section I -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/section_i_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Section I: Referral / Integration (YTD)"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/baseline_expand_more_24" />

            <TableLayout
                android:id="@+id/table_section_i"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0"
                android:visibility="gone">

                <TableRow android:background="@drawable/bg_table_header" android:paddingVertical="10dp">
                    <TextView android:text="Referral Indicator" android:textStyle="bold" android:paddingStart="12dp" android:textColor="@color/text_black"/>
                    <TextView android:text="Value" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_black"/>
                </TableRow>

                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Referred Nutrition to Health Facility" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/referral_nutrition_to_health" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Referral Feedback Received" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/referral_feedback_received" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Date of Referral" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/referral_date_of_referral" android:gravity="center" android:text="-" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="Date of Feedback" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/referral_date_of_feedback" android:gravity="center" android:text="-" android:textStyle="bold"/>
                </TableRow>
                <TableRow android:paddingVertical="10dp" android:background="@drawable/bg_table_row">
                    <TextView android:text="HIV/TB Integration Referrals" android:paddingStart="12dp" android:paddingEnd="8dp"/>
                    <TextView android:id="@+id/referral_hiv_tb_integration" android:gravity="center" android:text="0" android:textStyle="bold"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Comments -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Comments / Remarks"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No comments"
                android:textColor="@color/text_black" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
