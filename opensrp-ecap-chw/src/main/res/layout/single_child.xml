<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/register_columns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- HEADER: status stripe + child icon + name/age/caregiver -->
        <LinearLayout
            android:id="@+id/itemm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Status stripe (color set dynamically in code: green/red/orange/grey) -->
            <View
                android:id="@+id/mycolor"
                android:layout_width="4dp"
                android:layout_height="44dp"
                android:background="@color/reg_status_none" />

            <!-- Child avatar: gender icon set dynamically in code (boy/girl/unknown) -->
            <ImageView
                android:id="@+id/child_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_mother_icon_circle"
                android:contentDescription="@string/not_available"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_child_unknown_gender" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Name row + index chip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/child_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Child Name"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/dash_text"
                        android:textSize="16sp" />

                    <!-- Index tracing status chip -->
                    <TextView
                        android:id="@+id/index_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_primary"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="Index"
                        android:textAllCaps="true"
                        android:textColor="@android:color/white"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Age + gender line -->
                <TextView
                    android:id="@+id/child_age_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="5 years • Female"
                    android:textColor="@color/dash_text_secondary"
                    android:textSize="13sp" />

                <!-- Caregiver / mother name -->
                <TextView
                    android:id="@+id/caregiver_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Mother: Hope Chanda"
                    android:textColor="@color/dash_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/dash_divider" />

        <!-- ACTIONS: MUAC (optional) + Open profile -->
        <LinearLayout
            android:id="@+id/actions_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <!-- MUAC button: icon set dynamically via setCompoundDrawablesWithIntrinsicBounds -->
            <com.rey.material.widget.Button
                android:id="@+id/muac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_alert_outline"
                android:drawablePadding="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="MUAC"
                android:textAllCaps="false"
                android:textColor="@color/reg_pill_critical_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Open child profile -->
            <com.rey.material.widget.Button
                android:id="@+id/btn_open_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary_outline"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Profile"
                android:textAllCaps="false"
                android:textColor="@color/reg_pill_action_text"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
