<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overview_summary_row"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- ============ TESTING DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/overview_section_header"
                    style="@style/OverviewSectionHeader"
                    android:text="Testing Details" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/overview_section_details_left1"
                        style="@style/OverviewRowLabel"
                        android:text="Health Facility" />
                    <TextView
                        android:id="@+id/facility"
                        style="@style/OverviewRowValue"
                        android:inputType="textCapWords" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Testing Modality" />
                    <TextView android:id="@+id/testing_modality" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout
                    android:id="@+id/artLayout"
                    style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="ART Number" />
                    <TextView
                        android:id="@+id/art_number"
                        style="@style/OverviewRowValue"
                        android:textAllCaps="true" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Entry Point" />
                    <TextView android:id="@+id/entry_point" style="@style/OverviewRowValue" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ CASE WORKER DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/overview_section_header3"
                    style="@style/OverviewSectionHeader"
                    android:text="Case Worker Details" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Case Worker Name" />
                    <TextView
                        android:id="@+id/caseworker_name"
                        style="@style/OverviewRowValue"
                        android:text="Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Caseworker Phone" />
                    <TextView
                        android:id="@+id/phone"
                        style="@style/OverviewRowValue"
                        android:text="Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Implementing Partner" />
                    <TextView
                        android:id="@+id/implementing_partner"
                        style="@style/OverviewRowValue"
                        android:text="Not set" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ HISTORY ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/overview_section_header4"
                    style="@style/OverviewSectionHeader"
                    android:text="History" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Last Edited By" />
                    <TextView
                        android:id="@+id/date_edited"
                        style="@style/OverviewRowValue"
                        android:text="Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Date Case Created" />
                    <TextView
                        android:id="@+id/date_case_created"
                        style="@style/OverviewRowValue"
                        android:text="Not set" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
