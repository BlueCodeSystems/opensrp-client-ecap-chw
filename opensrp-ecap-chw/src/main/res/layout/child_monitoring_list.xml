<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_child_monitoring"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground">

            <!-- Left accent stripe -->
            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:minHeight="40dp"
                android:background="@color/register_hei_header" />

            <!-- Header text -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Visit label -->
                <TextView
                    android:id="@+id/tv_visit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Routine Infant Follow-up"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/register_hei_header" />

                <!-- Visit type (e.g. 6 weeks, 9 months) -->
                <TextView
                    android:id="@+id/tv_visit_type_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Visit: 6 weeks"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Date -->
                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Date: 22-09-2022"
                    android:textSize="12sp"
                    android:textColor="@color/light_grey_text"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/expand_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="2dp"
                android:contentDescription="@string/expand"
                android:src="@drawable/baseline_expand_more_24"
                app:tint="@color/register_hei_header" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/details_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/dash_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Visit type -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="Visit Type" />
                <TextView android:id="@+id/tv_visit_type" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- DBS due date -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="DBS due date" />
                <TextView android:id="@+id/tv_dbs_due_date" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- DBS actual date -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="DBS actual date" />
                <TextView android:id="@+id/tv_dbs_actual_date" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- DBS result -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="DBS result" />
                <TextView android:id="@+id/tv_dbs_result" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- HIV test -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="HIV test" />
                <TextView android:id="@+id/tv_hiv_test" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- AZT/3TC/NVP -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="AZT/3TC/NVP" />
                <TextView android:id="@+id/tv_nvp" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- CTX -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="CTX" />
                <TextView android:id="@+id/tv_ctx" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- Date tested -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="Date tested" />
                <TextView android:id="@+id/tv_date_tested" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- IYCF counselling -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="IYCF counselling" />
                <TextView android:id="@+id/tv_iycf_counselling" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- Infant feeding option -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="Infant feeding" />
                <TextView android:id="@+id/tv_feeding_option" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- High risk HEI -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="High risk HEI" />
                <TextView android:id="@+id/tv_high_risk_hei" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- MUAC / nutrition status -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="MUAC (cm)" />
                <TextView android:id="@+id/tv_nutrition_status" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- Medical complications -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="Medical complications" />
                <TextView android:id="@+id/tv_medical_complications" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- Oedema -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="Oedema" />
                <TextView android:id="@+id/tv_child_oedema" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- Oedema stage -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="Oedema stage" />
                <TextView android:id="@+id/tv_oedema_stage" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- TB screening symptoms -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="TB symptoms" />
                <TextView android:id="@+id/tv_tb_symptoms" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- Other TB symptom -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="Other TB symptom" />
                <TextView android:id="@+id/tv_tb_other" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- TB referral -->
            <LinearLayout style="@style/OverviewRow">
                <TextView style="@style/OverviewRowLabel" android:text="TB referral" />
                <TextView android:id="@+id/tb_referral" style="@style/OverviewRowValue" />
            </LinearLayout>

            <include layout="@layout/overview_row_divider" />

            <!-- TB comments -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/OverviewRowLabel"
                    android:layout_width="match_parent"
                    android:text="TB comments" />

                <TextView
                    android:id="@+id/tv_tb_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="14sp"
                    android:textColor="@color/textPrimary"
                    android:maxLines="3"
                    android:ellipsize="end" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider_grey" />

        <!-- ACTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/edit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_primary_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/edit_me"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/edit"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/edit"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/delete_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_alert_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/delete_record"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/delete"
                    android:src="@drawable/delete_icon"
                    app:tint="@color/pie_chart_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/delete"
                    android:textColor="@color/pie_chart_red"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
