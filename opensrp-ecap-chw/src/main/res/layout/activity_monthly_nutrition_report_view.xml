                            <TextView android:paddingStart="12dp" android:textColor="@color/text_black" android:text="STI Indicator" android:textStyle="bold" />
                            <TextView android:gravity="center" android:textColor="@color/text_black" android:text="Count" android:textStyle="bold" />
                        </TableRow>
                        <TableRow android:background="@drawable/bg_table_row" android:paddingVertical="10dp">
                            <TextView android:paddingEnd="8dp" android:paddingStart="12dp" android:text="STI Cases Referred" />
                            <TextView android:id="@+id/sti_referred" android:gravity="center" android:text="0" android:textStyle="bold" />
                        </TableRow>
                        <TableRow android:background="@drawable/bg_table_row" android:paddingVertical="10dp">
                            <TextView android:paddingEnd="8dp" android:paddingStart="12dp" android:text="STI Cases Treated" />
                            <TextView android:id="@+id/sti_treated" android:gravity="center" android:text="0" android:textStyle="bold" />
                        </TableRow>
                    </TableLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_grey" />

                <!-- Section I -->
                <LinearLayout
                    android:id="@+id/header_section_i"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Section I: Referral / Integration (YTD)"
                        android:textColor="@color/text_black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/icon_section_i"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_expand_more_24" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/content_section_i"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:stretchColumns="0">
                        <TableRow android:background="@drawable/bg_table_header" android:paddingVertical="10dp">
                            <TextView android:paddingStart="12dp" android:textColor="@color/text_black" android:text="Referral Indicator" android:textStyle="bold" />
                            <TextView android:gravity="center" android:textColor="@color/text_black" android:text="Value" android:textStyle="bold" />
                        </TableRow>
                        <TableRow android:background="@drawable/bg_table_row" android:paddingVertical="10dp">
                            <TextView android:paddingEnd="8dp" android:paddingStart="12dp" android:text="Referred Nutrition to Health Facility" />
                            <TextView android:id="@+id/referral_nutrition_to_health" android:gravity="center" android:text="0" android:textStyle="bold" />
                        </TableRow>
                        <TableRow android:background="@drawable/bg_table_row" android:paddingVertical="10dp">
                            <TextView android:paddingEnd="8dp" android:paddingStart="12dp" android:text="Referral Feedback Received" />
                            <TextView android:id="@+id/referral_feedback_received" android:gravity="center" android:text="0" android:textStyle="bold" />
                        </TableRow>
                        <TableRow android:background="@drawable/bg_table_row" android:paddingVertical="10dp">
                            <TextView android:paddingEnd="8dp" android:paddingStart="12dp" android:text="Date of Referral" />
                            <TextView android:id="@+id/referral_date_of_referral" android:gravity="center" android:text="-" android:textStyle="bold" />
                        </TableRow>
                        <TableRow android:background="@drawable/bg_table_row" android:paddingVertical="10dp">
                            <TextView android:paddingEnd="8dp" android:paddingStart="12dp" android:text="Date of Feedback" />
                            <TextView android:id="@+id/referral_date_of_feedback" android:gravity="center" android:text="-" android:textStyle="bold" />
                        </TableRow>
                        <TableRow android:background="@drawable/bg_table_row" android:paddingVertical="10dp">
                            <TextView android:paddingEnd="8dp" android:paddingStart="12dp" android:text="HIV/TB Integration Referrals" />
                            <TextView android:id="@+id/referral_hiv_tb_integration" android:gravity="center" android:text="0" android:textStyle="bold" />
                        </TableRow>
                    </TableLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_grey" />

                <!-- Comments -->
                <LinearLayout
                    android:id="@+id/header_section_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Comments / Remarks"
                        android:textColor="@color/text_black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/icon_section_comments"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_expand_more_24" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/content_section_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txt_comments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No comments"
                        android:textColor="@color/text_black" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</LinearLayout>
