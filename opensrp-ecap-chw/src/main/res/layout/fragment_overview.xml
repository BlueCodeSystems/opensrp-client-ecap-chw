<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overview_summary_row"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- ============ SUB POPULATIONS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/overview_section_header1"
                    style="@style/OverviewSectionHeader"
                    android:text="Sub Populations" />

                <!-- Horizontally scrollable so the chip row can never overflow the screen width -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/subPopLayout1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop1"
                            style="@style/OverviewChip"
                            android:text="C/ALHIV" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop2"
                            style="@style/OverviewChip"
                            android:text="HEI" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop3"
                            style="@style/OverviewChip"
                            android:text="C/WLHIV" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop4"
                            style="@style/OverviewChip"
                            android:text="AGYW" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop5"
                            style="@style/OverviewChip"
                            android:text="S/SV" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop6"
                            style="@style/OverviewChip"
                            android:text="C/FSWs" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop7"
                            style="@style/OverviewChip"
                            android:text="ABYM" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop8"
                            style="@style/OverviewChip"
                            android:text="SIBLING" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop9"
                            style="@style/OverviewChip"
                            android:text="C/A Childheaded Households" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop10"
                            style="@style/OverviewChip"
                            android:text="PBFW" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop11"
                            style="@style/OverviewChip"
                            android:text="C/A Chronically ill" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop12"
                            style="@style/OverviewChip"
                            android:text="C/A Female headed" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop13"
                            style="@style/OverviewChip"
                            android:text="C/ALWDisabilty" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop14"
                            style="@style/OverviewChip"
                            android:text="C/A Aged Headed Households" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop15"
                            style="@style/OverviewChip"
                            android:text="MUAC" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/subpop16"
                            style="@style/OverviewChip"
                            android:text="Violence" />

                        <TextView
                            android:visibility="gone"
                            android:id="@+id/other_subpop_member"
                            style="@style/OverviewChip"
                            android:text="Other" />

                        <Button
                            android:visibility="gone"
                            android:id="@+id/morePopulation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:layout_marginEnd="6dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:background="@drawable/bg_chip_primary"
                            android:text="More"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ ENROLLMENT DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/overview_section_header"
                    style="@style/OverviewSectionHeader"
                    android:text="Enrollment Details" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/overview_section_details_left1"
                        style="@style/OverviewRowLabel"
                        android:text="Date Referred" />
                    <TextView
                        android:id="@+id/referred"
                        style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Date Enrolled" />
                    <TextView android:id="@+id/enrolled" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/case_status_overview"
                        style="@style/OverviewRowLabel"
                        android:text="Health Facility" />
                    <TextView android:id="@+id/facility" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/school_status_overview"
                        style="@style/OverviewRowLabel"
                        android:text="School" />
                    <TextView android:id="@+id/school" style="@style/OverviewRowValue" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ ART STATUS AND VL DETAILS (collapsible) ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <RelativeLayout
                    android:visibility="visible"
                    android:id="@+id/myview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/overview_header_bg"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/myart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="40dp"
                        android:paddingStart="16dp"
                        android:singleLine="true"
                        android:text="ART Status &amp; VL Details"
                        android:textAllCaps="true"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@android:color/white" />

                    <ImageButton
                        android:id="@+id/arrow_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="12dp"
                        android:background="@android:color/transparent"
                        app:tint="@android:color/white"
                        android:src="@drawable/ic_down" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/mylayout"
                    android:visibility="gone"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Is on ART" />
                        <TextView android:id="@+id/is_art" style="@style/OverviewRowValue" android:text="Yes" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="ART Number" />
                        <TextView android:id="@+id/art_number" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Date Started ART" />
                        <TextView android:id="@+id/art_date" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Last VL Test" />
                        <TextView android:id="@+id/date_last_vl" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Results of Last VL" />
                        <TextView android:id="@+id/last_vl_result" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Recent VL Results" />
                        <TextView
                            android:id="@+id/recent_vl_result"
                            style="@style/OverviewRowValue"
                            android:textStyle="bold"
                            android:text="0" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Is Child VL Suppressed" />
                        <TextView android:id="@+id/vl_suppressed" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Next VL Test" />
                        <TextView android:id="@+id/next_vl_test" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Is Child on MMD" />
                        <TextView android:id="@+id/on_mmd" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Level of MMD" />
                        <TextView android:id="@+id/mmd_level" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Recent Level of MMD" />
                        <TextView
                            android:id="@+id/recent_mmd_level"
                            style="@style/OverviewRowValue"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ CAREGIVER DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/overview_section_header3"
                    style="@style/OverviewSectionHeader"
                    android:text="Current Caregiver Details" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Name" />
                    <TextView android:id="@+id/caregiver_name" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Gender" />
                    <TextView
                        android:id="@+id/caregiver_gender"
                        style="@style/OverviewRowValue"
                        android:capitalize="words" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Date of Birth" />
                    <TextView android:id="@+id/caregiver_dob" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="HIV Status" />
                    <TextView android:id="@+id/hiv_status" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Relationship to Child" />
                    <TextView android:id="@+id/child_relation" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Phone Number" />
                    <TextView android:id="@+id/caregiver_phone" style="@style/OverviewRowValue" />
                </LinearLayout>

                <!-- Shown only when an updated/new caregiver record exists -->
                <TextView
                    android:id="@+id/overview_section_header5"
                    style="@style/OverviewSectionHeader"
                    android:visibility="gone"
                    android:layout_marginTop="6dp"
                    android:text="Current caregiver details" />

                <LinearLayout
                    android:id="@+id/linearlayout_name"
                    style="@style/OverviewRow"
                    android:visibility="gone">
                    <TextView style="@style/OverviewRowLabel" android:text="Name" />
                    <TextView android:id="@+id/new_caregiver_name" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout
                    android:id="@+id/linearlayout_gender"
                    style="@style/OverviewRow"
                    android:visibility="gone">
                    <TextView style="@style/OverviewRowLabel" android:text="Gender" />
                    <TextView
                        android:id="@+id/new_caregiver_gender"
                        style="@style/OverviewRowValue"
                        android:capitalize="words" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout
                    android:id="@+id/linearlayout_dob"
                    style="@style/OverviewRow"
                    android:visibility="gone">
                    <TextView style="@style/OverviewRowLabel" android:text="Date of Birth" />
                    <TextView android:id="@+id/new_caregiver_dob" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout
                    android:id="@+id/linearlayout_status"
                    style="@style/OverviewRow"
                    android:visibility="gone">
                    <TextView style="@style/OverviewRowLabel" android:text="HIV Status" />
                    <TextView android:id="@+id/new_hiv_status" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout
                    android:id="@+id/linearlayout_relation"
                    style="@style/OverviewRow"
                    android:visibility="gone">
                    <TextView style="@style/OverviewRowLabel" android:text="Relationship to Child" />
                    <TextView android:id="@+id/new_child_relation" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout
                    android:id="@+id/linearlayout_phone"
                    style="@style/OverviewRow"
                    android:visibility="gone">
                    <TextView style="@style/OverviewRowLabel" android:text="Phone Number" />
                    <TextView android:id="@+id/new_caregiver_phone" style="@style/OverviewRowValue" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ HISTORY ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/overview_section_header4"
                    style="@style/OverviewSectionHeader"
                    android:text="History" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Last Edited By" />
                    <TextView android:id="@+id/edited_by" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Caseworker Phone" />
                    <TextView android:id="@+id/cPhone" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Date Last Edited" />
                    <TextView android:id="@+id/date_last_edited" style="@style/OverviewRowValue" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
