<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    card_view:cardBackgroundColor="@color/white"
    card_view:cardCornerRadius="14dp"
    card_view:cardElevation="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- Top row: Date + Edit button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="—"
                android:textColor="@color/dash_text"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_button_primary_outline"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/edit"
                android:src="@drawable/ic_edit"
                card_view:tint="@color/dash_accent" />
        </LinearLayout>

        <!-- Summary / description -->
        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/dash_text_secondary"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/dash_divider" />

        <!-- Bottom row: Follow-up date + Outcome button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="10dp">

            <!-- Follow-up date -->
            <TextView
                android:id="@+id/tvFollowUpDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Follow-up: —"
                android:textSize="12sp"
                android:textColor="@color/dash_text_muted" />

            <!-- Outcome button -->
            <Button
                android:id="@+id/btnAddOutcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary_outline"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:stateListAnimator="@null"
                android:text="Outcome"
                android:textAllCaps="false"
                android:textColor="@color/reg_pill_action_text"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
