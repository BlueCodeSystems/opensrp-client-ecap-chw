<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overview_summary_row"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- Shown only for an unscreened household; hidden once screening is complete -->
        <com.rey.material.widget.Button
            android:id="@+id/screenBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:background="@color/chw_primary"
            android:onClick="onClick"
            android:padding="14dp"
            android:text="Screen this Household"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:rd_enable="true"
            app:rd_rippleType="wave" />

        <LinearLayout
            android:id="@+id/llayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ HOUSEHOLD DETAILS ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/overview_section_header"
                        style="@style/OverviewSectionHeader"
                        android:text="Household Details" />

                    <LinearLayout
                        android:id="@+id/layoutSubpopulation"
                        style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Type of Caregiver" />
                        <TextView android:id="@+id/txtSubpopulation" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Household Income" />
                        <TextView android:id="@+id/income" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView
                            android:id="@+id/overview_section_details_left"
                            style="@style/OverviewRowLabel"
                            android:text="Income Source" />
                        <TextView android:id="@+id/income_source" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Number of Beds" />
                        <TextView android:id="@+id/beds" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Males less than 5 years old" />
                        <TextView android:id="@+id/males" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Males between 10 and 17 years old" />
                        <TextView android:id="@+id/malesBetweenTenAndSeventeen" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Females less than 5 years old" />
                        <TextView android:id="@+id/females" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Females between 10 and 17 years old" />
                        <TextView android:id="@+id/femalesBetweenTenAndSeventeen" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView
                            android:id="@+id/case_status_overview"
                            style="@style/OverviewRowLabel"
                            android:text="Signature" />
                        <ImageView
                            android:id="@+id/signature_view"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:background="@drawable/circle_light_grey"
                            android:scaleType="fitCenter" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============ GPS LOCATION ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/OverviewSectionHeader"
                        android:text="GPS Location" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView android:id="@+id/gps_location" style="@style/OverviewRowValue" android:text="Location" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============ ART STATUS AND VL DETAILS (collapsible) ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <RelativeLayout
                        android:visibility="visible"
                        android:id="@+id/myview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/overview_header_bg"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/myart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="40dp"
                            android:paddingStart="16dp"
                            android:singleLine="true"
                            android:text="ART Status &amp; VL Details"
                            android:textAllCaps="true"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:textColor="@android:color/white" />

                        <ImageButton
                            android:id="@+id/arrow_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="12dp"
                            android:background="@android:color/transparent"
                            app:tint="@android:color/white"
                            android:src="@drawable/ic_down" />

                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/mylayout"
                        android:visibility="gone"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="Is on ART" />
                            <TextView android:id="@+id/is_art" style="@style/OverviewRowValue" android:text="Yes" />
                        </LinearLayout>

                        <include layout="@layout/overview_row_divider" />

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="ART Number" />
                            <TextView android:id="@+id/art_number" style="@style/OverviewRowValue" />
                        </LinearLayout>

                        <include layout="@layout/overview_row_divider" />

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="Date Started ART" />
                            <TextView android:id="@+id/art_date" style="@style/OverviewRowValue" />
                        </LinearLayout>

                        <include layout="@layout/overview_row_divider" />

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="Last VL Test" />
                            <TextView android:id="@+id/date_last_vl" style="@style/OverviewRowValue" />
                        </LinearLayout>

                        <include layout="@layout/overview_row_divider" />

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="Results of Last VL" />
                            <TextView android:id="@+id/last_vl_result" style="@style/OverviewRowValue" />
                        </LinearLayout>

                        <include layout="@layout/overview_row_divider" />

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="Recent VL Results" />
                            <TextView
                                android:id="@+id/recent_vl_result"
                                style="@style/OverviewRowValue"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <include layout="@layout/overview_row_divider" />

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="Is Caregiver VL Suppressed" />
                            <TextView android:id="@+id/vl_suppressed" style="@style/OverviewRowValue" />
                        </LinearLayout>

                        <include layout="@layout/overview_row_divider" />

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="Next VL Test" />
                            <TextView android:id="@+id/next_vl_test" style="@style/OverviewRowValue" />
                        </LinearLayout>

                        <include layout="@layout/overview_row_divider" />

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="Is Caregiver on MMD" />
                            <TextView android:id="@+id/on_mmd" style="@style/OverviewRowValue" />
                        </LinearLayout>

                        <include layout="@layout/overview_row_divider" />

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="Level of MMD" />
                            <TextView android:id="@+id/mmd_level" style="@style/OverviewRowValue" />
                        </LinearLayout>

                        <include layout="@layout/overview_row_divider" />

                        <LinearLayout style="@style/OverviewRow">
                            <TextView style="@style/OverviewRowLabel" android:text="Recent Level of MMD" />
                            <TextView
                                android:id="@+id/recent_mmd_level"
                                style="@style/OverviewRowValue"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============ EMERGENCY CONTACT DETAILS ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/overview_section_header2"
                        style="@style/OverviewSectionHeader"
                        android:text="Emergency Contact Details" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Name" />
                        <TextView android:id="@+id/emergency_name" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Number" />
                        <TextView android:id="@+id/emergency_number" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============ HISTORY ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/overview_section_header3"
                        style="@style/OverviewSectionHeader"
                        android:text="History" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Last Edited By" />
                        <TextView android:id="@+id/h_edited_by" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Caseworker Phone" />
                        <TextView android:id="@+id/h_phone" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="Date Last Edited" />
                        <TextView android:id="@+id/h_date" style="@style/OverviewRowValue" android:text="Not Set" />
                    </LinearLayout>

                    <!-- Nutrition/MUAC warning banner -->
                    <LinearLayout
                        android:visibility="gone"
                        android:id="@+id/muac_warning"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_chip_subpop"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:src="@drawable/ic_icon_warning"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textStyle="italic"
                            android:text="Please complete Nutrition Screening using MUAC scores for each child in the Members tab"
                            android:textColor="@color/register_vca_icon" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
