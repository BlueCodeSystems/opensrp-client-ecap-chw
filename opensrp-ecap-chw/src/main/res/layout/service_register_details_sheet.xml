<?xml version="1.0" encoding="utf-8"?>
<!-- Details of one service register record, opened by tapping its row. ServiceRegisterDetailsSheet fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/service_details_sheet_bg"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/service_details_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/service_details_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/dash_text"
            android:textSize="20sp"
            tools:text="Mwila Banda" />

        <TextView
            android:id="@+id/service_details_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/dash_text_secondary"
            android:textSize="14sp"
            tools:text="iCCM 10234-0012 · F · 4y · C/ALHIV" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/service_details_status"
                style="@style/ServiceRegisterPill"
                tools:background="@drawable/reg_pill_warning"
                tools:text="Missed · 3 days late" />

            <TextView
                android:id="@+id/service_details_due"
                style="@style/ServiceRegisterPill"
                android:layout_marginStart="6dp"
                tools:background="@drawable/reg_pill_neutral"
                tools:text="Reminder given" />
        </LinearLayout>

        <TextView
            android:id="@+id/service_details_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/dash_text_muted"
            android:textSize="12sp"
            tools:text="Last updated 3 Nov 2026" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dash_divider" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/service_details_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/service_details_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dash_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/service_details_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/service_register_close"
            android:textColor="@color/dash_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/service_details_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/service_details_action_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Record outcome" />
    </LinearLayout>

</LinearLayout>
