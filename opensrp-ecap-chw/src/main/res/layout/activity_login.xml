<?xml version="1.0" encoding="utf-8"?>
<!--
  Login screen: navy header band, a white sign-in card and the coat of arms at the bottom.
  The title and card are centred in the space above the coat of arms, and the band always ends
  login_header_overlap into the card. Sizes come from values/, values-sw600dp/ and
  values-sw720dp/ dimens so phones and tablets each get a proportionate layout.
  LoginActivity, LoginPresenter and BaseLoginActivity look up the login_* view ids, and
  BaseLoginPresenter casts login_layout to a RelativeLayout, so keep both when changing this.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/canvasSV"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_page_bg"
    android:fillViewport="true"
    android:isScrollContainer="true">

    <RelativeLayout
        android:id="@+id/login_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/login_page_bg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Navy band from the top of the screen to login_header_overlap into the card -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/login_header_bg"
                app:layout_constraintBottom_toBottomOf="@id/header_anchor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Space
                android:id="@+id/header_anchor"
                android:layout_width="0dp"
                android:layout_height="@dimen/login_header_overlap"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/middle_section" />

            <!-- Top section: app name on the navy band -->
            <LinearLayout
                android:id="@+id/top_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/login_screen_padding"
                android:layout_marginTop="@dimen/login_section_gap"
                android:layout_marginEnd="@dimen/login_screen_padding"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/middle_section"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_max="@dimen/login_card_max_width">

                <TextView
                    android:id="@+id/login_title_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_horizontal"
                    android:text="@string/login_title"
                    android:textColor="@color/white"
                    android:textSize="@dimen/login_title_size" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/login_header_subtitle"
                    android:textSize="@dimen/login_subtitle_size" />

            </LinearLayout>

            <!-- Middle section: the sign-in card -->
            <LinearLayout
                android:id="@+id/middle_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/login_screen_padding"
                android:layout_marginTop="@dimen/login_section_gap"
                android:layout_marginEnd="@dimen/login_screen_padding"
                android:layout_marginBottom="@dimen/login_section_gap"
                android:background="@drawable/login_card_bg"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="@dimen/login_card_padding"
                app:layout_constraintBottom_toTopOf="@id/bottom_section"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/top_section"
                app:layout_constraintWidth_max="@dimen/login_card_max_width">

                <!-- Capped so the whole screen fits without scrolling; the width shrinks to match -->
                <ImageView
                    android:id="@+id/login_logo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxHeight="@dimen/login_logo_max_height"
                    android:contentDescription="@string/logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/iccms" />

                <TextView
                    style="@style/LoginFieldLabel"
                    android:layout_marginTop="24dp"
                    android:labelFor="@id/login_user_name_edit_text"
                    android:text="@string/username" />

                <EditText
                    android:id="@+id/login_user_name_edit_text"
                    style="@style/LoginField"
                    android:autofillHints="username"
                    android:drawableStart="@drawable/ic_person_black_24dp"
                    android:hint="@string/login_username_hint"
                    android:imeOptions="actionNext"
                    android:inputType="text" />

                <TextView
                    style="@style/LoginFieldLabel"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/login_password_edit_text"
                    android:text="@string/password" />

                <EditText
                    android:id="@+id/login_password_edit_text"
                    style="@style/LoginField"
                    android:autofillHints="password"
                    android:drawableStart="@drawable/ic_login_lock"
                    android:hint="@string/login_password_hint"
                    android:imeActionId="@integer/login"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/login_show_password_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-6dp"
                        android:buttonTint="@color/login_accent" />

                    <TextView
                        android:id="@+id/login_show_password_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/show_password_text"
                        android:textColor="@color/login_text_secondary"
                        android:textSize="@dimen/login_label_size" />

                </LinearLayout>

                <Button
                    android:id="@+id/login_login_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/login_button_height"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/login_button_bg"
                    android:elevation="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:onClick="onClick"
                    android:stateListAnimator="@animator/login_button_elevation"
                    android:textStyle="bold"
                    android:text="@string/login_text"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/login_button_text_size" />

                <TextView
                    android:id="@+id/login_build_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_horizontal"
                    android:text="@string/app_version"
                    android:textColor="@color/login_hint"
                    android:textSize="@dimen/login_build_text_view_textSize" />

            </LinearLayout>

            <!-- Bottom section: coat of arms and ministry name on the bottom edge -->
            <LinearLayout
                android:id="@+id/bottom_section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/login_bottom_margin"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/opensrp_logo_image_view"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/login_coat_of_arms_height"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/login_coat_of_arms"
                    android:scaleType="fitCenter"
                    android:src="@drawable/iccms_coat_of_arms" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="@string/login_ministry"
                    android:textAllCaps="true"
                    android:textColor="@color/login_text"
                    android:textSize="@dimen/login_ministry_text_size" />

            </LinearLayout>

            <!-- Developer credit: small and faded in the corner, out of the main flow -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/login_developer_logo_height"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="@dimen/login_bottom_margin"
                android:adjustViewBounds="true"
                android:alpha="0.5"
                android:contentDescription="@string/login_developer_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/iccms_bluecode_logo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </RelativeLayout>
</ScrollView>
