<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register_columns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main row -->
        <LinearLayout
            android:id="@+id/itemm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left PMTCT accent strip -->
            <View
                android:id="@+id/mystatusx"
                android:layout_width="6dp"
                android:layout_height="match_parent"
                android:minHeight="76dp"
                android:background="@color/register_pmtct_icon" />

            <!-- Mother avatar -->
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/circle_light_grey"
                android:backgroundTint="@color/register_pmtct_icon">

                <ImageView
                    android:id="@+id/gender_image"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mother"
                    android:tint="@color/white"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/icon_mother_desc" />
            </FrameLayout>

            <!-- Center: text content -->
            <LinearLayout
                android:id="@+id/content_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Name -->
                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/familyNameTextView"
                    style="@style/CustomFontTextViewStyle.ClientList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/textPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Chanda Mwape" />

                <!-- Age / Gender -->
                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/gender_age"
                    style="@style/CustomFontTextViewStyle.ClientList.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    tools:text="Female · 28 yrs" />

                <!-- Programme stage -->
                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/client_type"
                    style="@style/CustomFontTextViewStyle.ClientList.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/register_pmtct_icon"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="ANC · 28 weeks" />

                <!-- Facility / village -->
                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/villageTextView"
                    style="@style/CustomFontTextViewStyle.ClientList.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:drawableStart="@drawable/ic_household"
                    android:drawablePadding="4dp"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    tools:text="Kanyama Clinic" />

            </LinearLayout>

            <!-- Right: VL chips + badges -->
            <LinearLayout
                android:id="@+id/action_cluster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- Unsuppressed VL chip -->
                <TextView
                    android:id="@+id/unsuppressed_vl_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/unsuppressed_vl_flag"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_danger"
                    android:visibility="gone" />

                <!-- Suppressed VL chip -->
                <TextView
                    android:id="@+id/suppressed_vl_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/suppressed_vl_flag"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_success" />

                <!-- Index pill -->
                <TextView
                    android:id="@+id/index_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/rounded_corner_index"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="Index"
                    android:textColor="@color/dark_grey_text"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <!-- Case plan icon -->
                <ImageView
                    android:id="@+id/index_case_plan"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_baseline_content_paste_24"
                    android:visibility="gone"
                    app:tint="@color/light_grey_text" />

            </LinearLayout>

            <!-- Chevron -->
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- Thin divider before footer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_grey" />

        <!-- Footer: enrolled date label -->
        <LinearLayout
            android:id="@+id/footer_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/enrolled_date_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PMTCT Programme"
                android:textSize="10sp"
                android:textColor="@color/register_pmtct_icon"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- Inline unsuppressed VL alert panel -->
        <include
            android:id="@+id/unsuppressed_alert"
            layout="@layout/view_pmtct_alert_unsuppressed_vl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
