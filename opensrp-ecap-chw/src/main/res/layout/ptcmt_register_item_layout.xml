<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register_columns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Left status stripe -->
    <View
        android:id="@+id/mystatusx"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_status_stripe" />

    <!-- Main row content -->
    <LinearLayout
        android:id="@+id/itemm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal">

        <!-- Left: avatar -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical">

            <!-- You can swap this icon based on gender or client type -->
            <ImageView
                android:id="@+id/gender_image"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mother"
                android:contentDescription="@string/icon_mother_desc" />
        </FrameLayout>

        <!-- Center: main text content (keeps your original IDs) -->
        <LinearLayout
            android:id="@+id/content_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1: name + gender/age in a single line -->
            <LinearLayout
                android:id="@+id/row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/familyNameTextView"
                    style="@style/CustomFontTextViewStyle.ClientList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Patient Name"
                    android:textColor="@color/text_black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Patient Name" />

                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/gender_age"
                    style="@style/CustomFontTextViewStyle.ClientList.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Female · 3 years"
                    android:textColor="@color/light_grey_text"
                    android:textSize="14sp"
                    tools:text="Female · 28 yrs" />
            </LinearLayout>

            <!-- Optional client type -->
            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/client_type"
                style="@style/CustomFontTextViewStyle.ClientList.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Client Type: SNT"
                android:textColor="@color/light_grey_text"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Client Type: PMTCT" />

            <!-- Location / village / facility -->
            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/villageTextView"
                style="@style/CustomFontTextViewStyle.ClientList.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Village / Facility"
                android:textColor="@color/light_grey_text"
                android:textSize="14sp"
                tools:text="Kanyama Clinic" />
        </LinearLayout>

        <!-- Right: action cluster (VL flags + index label + case plan) -->
        <LinearLayout
            android:id="@+id/action_cluster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Unsuppressed VL flag chip -->
            <Button
                android:id="@+id/unsuppressed_vl_flag"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:layout_marginStart="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/unsuppressed_vl_flag"
                android:textAllCaps="false"
                android:textColor="@color/colorRed"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/ripple_button_alert"
                android:visibility="gone" />

            <!-- Suppressed VL flag chip -->
            <Button
                android:id="@+id/suppressed_vl_flag"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/suppressed_vl_flag"
                android:textAllCaps="false"
                android:textColor="@color/pie_chart_yes_green"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/ripple_button_success"
                android:visibility="gone" />

            <!-- Index pill -->
            <TextView
                android:id="@+id/index_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/rounded_corner_index"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Index"
                android:textColor="@color/dark_grey_text"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Case plan icon -->
            <ImageView
                android:id="@+id/index_case_plan"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Case plan"
                android:src="@drawable/ic_baseline_content_paste_24"
                android:visibility="gone"
                app:tint="@color/light_grey_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- Inline alert panel for Unsuppressed VL (appears below row) -->
    <include
        android:id="@+id/unsuppressed_alert"
        layout="@layout/view_pmtct_alert_unsuppressed_vl"
        android:visibility="gone"
        android:layout_below="@id/itemm"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        tools:ignore="IncludeLayoutParam" />

</RelativeLayout>
