<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/report_view_toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_profile_header_gradient"
        android:elevation="2dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        app:titleTextColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/report_view_back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back_white_24dp"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/report_view_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/report_community_alert"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_edit_report"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/edit"
                android:padding="8dp"
                android:src="@drawable/ic_edit_white"
                app:tint="@color/white" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/header_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#000000"
                android:padding="1dp">

                <!-- ROW 1: Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#638790"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Community-Based Surveillance Suspected Diseases and Public Health Events Monthly Log Sheet"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Meta Data Section -->
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="4dp">

                    <TableRow android:padding="2dp">
                        <TextView android:text="District " android:textColor="#000000" android:textStyle="bold"/>
                        <TextView android:id="@+id/txt_district" android:layout_width="150dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                        <TextView android:text=" Facility " android:textColor="#000000" android:textStyle="bold" android:paddingLeft="8dp"/>
                        <TextView android:id="@+id/txt_facility_name" android:layout_width="200dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                        <TextView android:text=" Province " android:textColor="#000000" android:textStyle="bold" android:paddingLeft="8dp"/>
                        <TextView android:id="@+id/txt_province" android:layout_width="120dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                    </TableRow>

                    <TableRow android:padding="2dp">
                        <TextView android:text="Community: " android:textColor="#000000" android:textStyle="bold"/>
                        <TextView android:id="@+id/txt_community" android:layout_width="150dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                        <TextView android:text=" Month/Year " android:textColor="#000000" android:textStyle="bold" android:paddingLeft="8dp"/>
                        <TextView android:id="@+id/txt_reporting_month" android:layout_width="100dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                        <TextView android:text=" Ward " android:textColor="#000000" android:textStyle="bold" android:paddingLeft="8dp"/>
                        <TextView android:id="@+id/txt_ward" android:layout_width="100dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                    </TableRow>

                    <TableRow android:padding="2dp">
                        <TextView android:text="CCW Name " android:textColor="#000000" android:textStyle="bold"/>
                        <TextView android:id="@+id/txt_caseworker_name" android:layout_width="150dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                        <TextView android:text=" Phone " android:textColor="#000000" android:textStyle="bold" android:paddingLeft="8dp"/>
                        <TextView android:id="@+id/txt_phone_number" android:layout_width="100dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                        <TextView android:text=" Form ID " android:textColor="#000000" android:textStyle="bold" android:paddingLeft="8dp"/>
                        <TextView android:id="@+id/txt_form_id" android:layout_width="100dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                    </TableRow>

                    <TableRow android:padding="2dp">
                        <TextView android:text="Super Mentor " android:textColor="#000000" android:textStyle="bold"/>
                        <TextView android:id="@+id/txt_super_mentor_name" android:layout_width="150dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                        <TextView android:text=" SM Contact " android:textColor="#000000" android:textStyle="bold" android:paddingLeft="8dp"/>
                        <TextView android:id="@+id/txt_super_mentor_contact" android:layout_width="100dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                        <TextView android:text=" Date " android:textColor="#000000" android:textStyle="bold" android:paddingLeft="8dp"/>
                        <TextView android:id="@+id/txt_date_reporting" android:layout_width="100dp" android:textColor="#000000" android:background="@drawable/bottom_border_line" android:paddingLeft="4dp"/>
                    </TableRow>
                </TableLayout>

                <!-- Main Data Table -->
                <TableLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#000000">

                    <!-- Headers -->
                    <TableRow android:background="#FFFFFF">
                        <TextView android:layout_width="40dp" android:layout_height="match_parent" android:text="S/N" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:layout_width="120dp" android:layout_height="match_parent" android:text="Type of illness /Condition/ Event/Alert" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:layout_width="100dp" android:layout_height="match_parent" android:text="When did this happen (DD/MM/YYYY )" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:layout_width="120dp" android:layout_height="match_parent" android:text="Where did this happen (Community, District)" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:layout_width="120dp" android:layout_height="match_parent" android:text="Suspected Cases" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:layout_width="180dp" android:layout_height="match_parent" android:text="How many have been affected" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:layout_width="180dp" android:layout_height="match_parent" android:text="How many died" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:layout_width="100dp" android:layout_height="match_parent" android:text="What action was taken" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:layout_width="120dp" android:layout_height="match_parent" android:text="Was Super Mentor (Supervisor ) involved" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background" android:textStyle="bold" android:textSize="10sp"/>
                    </TableRow>

                    <!-- Data Row -->
                    <TableRow android:background="#FFFFFF">
                        <!-- S/N -->
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="1" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                        <!-- Type -->
                        <TextView android:id="@+id/txt_illness_type" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center_vertical" android:padding="4dp" android:background="@drawable/table_cell_background" android:textSize="10sp"/>
                        <!-- When -->
                        <TextView android:id="@+id/txt_event_date" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:padding="4dp" android:background="@drawable/table_cell_background" android:textSize="10sp"/>
                        <!-- Where -->
                        <LinearLayout android:layout_width="120dp" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/table_cell_background">
                            <TextView android:id="@+id/txt_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#000000" android:padding="4dp" android:textSize="10sp"/>
                            <TextView android:id="@+id/txt_gps" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#638790" android:padding="4dp" android:textSize="8sp" android:textStyle="italic"/>
                        </LinearLayout>

                        <!-- Suspected Cases -->
                        <TextView
                            android:id="@+id/txt_case_total"
                            android:layout_width="120dp"
                            android:layout_height="match_parent"
                            android:textColor="#000000"
                            android:gravity="center"
                            android:padding="4dp"
                            android:background="@drawable/table_cell_background"
                            android:textStyle="bold"
                            android:textSize="12sp"/>

                        <!-- Affected -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/table_cell_background">
                            <!-- Female -->
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Female" android:textColor="#000000" android:gravity="center" android:background="#E0E0E0" android:padding="2dp" android:textStyle="bold" android:textSize="9sp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0-4 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5-9 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10-17 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="18+ y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:id="@+id/affected_f_0_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/affected_f_5_9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/affected_f_10_17" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/affected_f_18_plus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                            </LinearLayout>
                            <!-- Male -->
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Male" android:textColor="#000000" android:gravity="center" android:background="#E0E0E0" android:padding="2dp" android:textStyle="bold" android:textSize="9sp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0-4 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5-9 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10-17 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="18+ y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:id="@+id/affected_m_0_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/affected_m_5_9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/affected_m_10_17" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/affected_m_18_plus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Died -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/table_cell_background">
                            <!-- Female -->
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Female" android:textColor="#000000" android:gravity="center" android:background="#E0E0E0" android:padding="2dp" android:textStyle="bold" android:textSize="9sp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0-4 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5-9 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10-17 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="18+ y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:id="@+id/dead_f_0_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/dead_f_5_9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/dead_f_10_17" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/dead_f_18_plus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                            </LinearLayout>
                            <!-- Male -->
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Male" android:textColor="#000000" android:gravity="center" android:background="#E0E0E0" android:padding="2dp" android:textStyle="bold" android:textSize="9sp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0-4 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5-9 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10-17 y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="18+ y" android:textColor="#000000" android:gravity="center" android:textSize="8sp" android:padding="1dp" android:background="@drawable/table_cell_background"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:id="@+id/dead_m_0_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/dead_m_5_9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/dead_m_10_17" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                                <TextView android:id="@+id/dead_m_18_plus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:background="@drawable/table_cell_background"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Action -->
                        <TextView android:id="@+id/txt_action_taken" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center_vertical" android:padding="4dp" android:background="@drawable/table_cell_background" android:textSize="10sp"/>
                        <!-- Supervisor -->
                        <TextView android:id="@+id/txt_response_performed" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center_vertical" android:padding="4dp" android:background="@drawable/table_cell_background" android:textSize="10sp"/>
                    </TableRow>
                </TableLayout>

                <!-- Footer Section (Comments/Review) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="8dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Comments:" android:textStyle="bold" android:textColor="#000000"/>
                    <TextView android:id="@+id/txt_comments" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#000000" android:padding="4dp" android:background="@drawable/bottom_border_line" android:minLines="2"/>

                    <View android:layout_width="match_parent" android:layout_height="16dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reviewed by: Name of Super Mentor (Supervisor):" android:textStyle="bold" android:textColor="#000000"/>
                    <TextView android:id="@+id/txt_supervisor_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#000000" android:padding="4dp" android:background="@drawable/bottom_border_line"/>

                    <TableRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Date reviewed: " android:textStyle="bold" android:textColor="#000000"/>
                        <TextView android:id="@+id/txt_date_reviewed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:padding="4dp" android:background="@drawable/bottom_border_line"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Signature: " android:textStyle="bold" android:textColor="#000000" android:paddingLeft="16dp"/>
                        <TextView android:id="@+id/txt_signature" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#000000" android:padding="4dp" android:background="@drawable/bottom_border_line"/>
                    </TableRow>
                </LinearLayout>

                <!-- Compatibility hidden views -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <View android:id="@+id/header_sb_q1" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/content_sb_q1" android:layout_width="0dp" android:layout_height="0dp" />
                    <ImageView android:id="@+id/icon_sb_q1" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/header_sb_q2" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/content_sb_q2" android:layout_width="0dp" android:layout_height="0dp" />
                    <ImageView android:id="@+id/icon_sb_q2" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/header_sc" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/content_sc" android:layout_width="0dp" android:layout_height="0dp" />
                    <ImageView android:id="@+id/icon_sc" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/header_comments" android:layout_width="0dp" android:layout_height="0dp" />
                    <View android:id="@+id/content_comments" android:layout_width="0dp" android:layout_height="0dp" />
                    <ImageView android:id="@+id/icon_comments" android:layout_width="0dp" android:layout_height="0dp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>
