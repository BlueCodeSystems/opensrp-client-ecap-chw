<?xml version="1.0" encoding="utf-8"?>
<!-- The row every register uses: status stripe, register icon, name with the record's ID, a summary line, a
     detail line, then status chips, a slot for register-specific extras and the action. RegisterRow binds it. -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register_columns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/row_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/reg_status_none" />

        <FrameLayout
            android:id="@+id/row_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/circle_light_grey">

            <ImageView
                android:id="@+id/row_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- The only flexible-width column, so the row can never overflow the screen -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/row_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/dash_text"
                    android:textSize="16sp"
                    tools:text="Mwila Banda" />

                <TextView
                    android:id="@+id/row_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="@color/dash_text_muted"
                    android:textSize="12sp"
                    tools:text="iCCM 10234-0012" />
            </LinearLayout>

            <TextView
                android:id="@+id/row_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dash_text_secondary"
                android:textSize="13sp"
                tools:text="F · 4y · C/ALHIV" />

            <TextView
                android:id="@+id/row_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/dash_text"
                android:textSize="13sp"
                tools:text="ART · 12 Nov 2026, 09:00" />

            <LinearLayout
                android:id="@+id/row_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Chips can wrap the name of a long status, so they share the width before the button -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/row_status"
                        style="@style/ServiceRegisterPill"
                        tools:background="@drawable/reg_pill_info"
                        tools:text="In 3 days"
                        tools:textColor="@color/reg_pill_info_text" />

                    <TextView
                        android:id="@+id/row_due"
                        style="@style/ServiceRegisterPill"
                        android:layout_marginStart="6dp"
                        tools:background="@drawable/reg_pill_neutral"
                        tools:text="Reminder given"
                        tools:textColor="@color/reg_pill_neutral_text" />
                </LinearLayout>

                <!-- Register-specific extras, e.g. the household's members -->
                <LinearLayout
                    android:id="@+id/row_trailing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/row_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/reg_pill_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/reg_pill_action_text"
                    android:textSize="12sp"
                    tools:text="Record outcome" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
