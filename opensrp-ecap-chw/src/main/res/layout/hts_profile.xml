<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    tools:context=".activity.IndexDetailsActivity"
    android:layout_height="match_parent"
    android:background="@color/dash_bg">


        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/collapsing_toolbar_appbarlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/profile_hts_header"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:elevation="4dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/profile_hts_header"
                app:contentScrim="@color/profile_hts_header"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbarx"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                    app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

                <LinearLayout
                    android:id="@+id/profile_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/actionBarSize"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="1.5">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/profile_household_avatar">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_shield_droplet"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/vca_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Charity Otala"
                        android:textColor="@android:color/white"
                        android:textSize="24sp" />

                    <!-- Sex, age and ID as pills; the dot separators are kept for the activity but not shown -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/vca_gender"
                            style="@style/ProfileHeaderPill"
                            android:text="FEMALE" />

                        <TextView
                            android:id="@+id/gender_spacer"
                            android:layout_width="8dp"
                            android:layout_height="wrap_content"
                            android:textSize="1sp" />

                        <TextView
                            android:id="@+id/vca_age"
                            style="@style/ProfileHeaderPill"
                            android:text="5" />

                        <TextView
                            android:id="@+id/age_spacer"
                            android:layout_width="8dp"
                            android:layout_height="wrap_content"
                            android:textSize="1sp" />

                        <TextView
                            android:id="@+id/childid"
                            style="@style/ProfileHeaderPill"
                            android:text="ID : 3988760" />
                    </LinearLayout>

                    <!-- Hidden in this profile; kept for the activity's click handling -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/myservice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/profile_header_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:onClick="onClick"
                            android:paddingStart="@dimen/profile_btn_registration_info_padding"
                            android:paddingTop="9dp"
                            android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                            android:paddingBottom="9dp"
                            android:text="Service Reports"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/show_referrals"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/profile_header_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:onClick="onClick"
                            android:paddingStart="@dimen/profile_btn_registration_info_padding"
                            android:paddingTop="9dp"
                            android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                            android:paddingBottom="9dp"
                            android:text="Referrals"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/household_profile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/profile_header_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:onClick="onClick"
                            android:paddingStart="@dimen/profile_btn_registration_info_padding"
                            android:paddingTop="9dp"
                            android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                            android:paddingBottom="9dp"
                            android:text="Household Profile"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <!-- Tabs on a white strip, divided from the records below -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                app:tabContentStart="0dp"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/profile_hts_header"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="3dp"
                app:tabMaxWidth="0dp"
                app:tabMode="fixed"
                app:tabRippleColor="@color/dash_divider"
                app:tabSelectedTextColor="@color/dash_text"
                app:tabTextAppearance="@style/CustomFontTextViewStyle.tabIndicator.sub.white"
                app:tabTextColor="@color/dash_text_secondary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dash_divider" />

        </com.google.android.material.appbar.AppBarLayout>


        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Overlay for the action menu; a direct sibling so the header can collapse as the tabs scroll -->
    <RelativeLayout
        android:id="@+id/activity_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/fab_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/menu_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/fab"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="24dp"
            android:layout_marginRight="24dp"
            android:orientation="vertical"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/vca_screening"
                android:onClick="onClick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    style="@style/HtsActionChip"
                    android:layout_toLeftOf="@+id/callFabx"
                    android:text="Edit details" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFabx"
                    style="@style/HtsActionMiniFab"
                    app:srcCompat="@drawable/baseline_mode_edit_24" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/assessment"
                android:onClick="onClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/CallTextViewHint"
                    style="@style/HtsActionChip"
                    android:layout_toLeftOf="@+id/fabAssessment"
                    android:text="Add Contact" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabAssessment"
                    style="@style/HtsActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/case_plan"
                android:onClick="onClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_toLeftOf="@+id/case_plan_fab"
                    android:background="#666666"
                    android:textColor="@android:color/white"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:minWidth="50dp"
                    android:padding="10dp"
                    android:text="CA Case Plan"
                    android:textStyle="italic"
                    />


                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/case_plan_fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add"/>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/referral"
                android:onClick="onClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_toLeftOf="@+id/refer_to_facility_fab"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:minWidth="50dp"
                    android:padding="10dp"
                    android:text="Referral Form"
                    android:textStyle="italic"
                    android:background="#666666"
                    android:textColor="@android:color/white" />


                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/refer_to_facility_fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/baseline_mode_edit_24" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/household_visitation_for_vca"
                android:onClick="onClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_toLeftOf="@+id/household_visitation_for_vca_fab"
                    android:background="#666666"
                    android:textColor="@android:color/white"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:minWidth="50dp"
                    android:padding="10dp"
                    android:text="Follow-up Visitation"
                    android:textStyle="italic"
                     />


                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/household_visitation_for_vca_fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add"  />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/hiv_assessment"
                android:onClick="onClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_toLeftOf="@+id/hiv_risk"
                    android:background="#666666"
                    android:textColor="@android:color/white"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:minWidth="50dp"
                    android:padding="10dp"
                    android:text="HIV Risk Assessment"
                    android:textStyle="italic"
                     />


                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/hiv_risk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/baseline_mode_edit_24" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/hiv_assessment2"
                android:onClick="onClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_toLeftOf="@+id/hiv_risk2"
                    android:background="#666666"
                    android:textColor="@android:color/white"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:minWidth="50dp"
                    android:padding="10dp"
                    android:text="HIV Risk Assessment"
                    android:textStyle="italic"
                    />


                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/hiv_risk2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/baseline_mode_edit_24" />

            </RelativeLayout>

        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:onClick="onClick"
            android:tint="@android:color/white"
            app:backgroundTint="@color/text_black"
            app:fabSize="normal"
            app:srcCompat="@drawable/baseline_mode_edit_24" />
    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
