<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:viewBindingIgnore="true"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/report_view_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_vca_header"
        android:elevation="2dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        app:titleTextColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/report_view_back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back_white_24dp"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/report_view_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/vca_service_report_title"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dash_bg"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- ============ REPORT DETAILS ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView style="@style/ReportSectionHeader" android:text="@string/report_details" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/date_of_service" />
                        <TextView android:id="@+id/txt_date" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/location" />
                        <TextView android:id="@+id/txt_location" style="@style/OverviewRowValue" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============ SERVICES PROVIDED ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView style="@style/ReportSectionHeader" android:text="@string/services_provided_header" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/services_provided" />
                        <TextView android:id="@+id/txt_services" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/other" />
                        <TextView android:id="@+id/txt_other_service" style="@style/OverviewRowValue" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============ SCHOOL SERVICES ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView style="@style/ReportSectionHeader" android:text="@string/school_services" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/services_provided" />
                        <TextView android:id="@+id/txt_school_services" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/other" />
                        <TextView android:id="@+id/txt_other_school_services" style="@style/OverviewRowValue" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============ SAFETY SERVICES ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView style="@style/ReportSectionHeader" android:text="@string/safety_services" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/services_provided" />
                        <TextView android:id="@+id/txt_safe_services" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/other" />
                        <TextView android:id="@+id/txt_other_safe_services" style="@style/OverviewRowValue" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============ STABILITY SERVICES ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView style="@style/ReportSectionHeader" android:text="@string/stability_services" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/services_provided" />
                        <TextView android:id="@+id/txt_stable_services" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/other" />
                        <TextView android:id="@+id/txt_other_stable_services" style="@style/OverviewRowValue" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============ HIV & ART DETAILS ============ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/hiv_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView style="@style/ReportSectionHeader" android:text="@string/hiv_art_details" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/hiv_status" />
                        <TextView android:id="@+id/txt_hiv_status" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/pregnant_breastfeeding" />
                        <TextView android:id="@+id/txt_pregnant_breastfeeding" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/art_clinic" />
                        <TextView android:id="@+id/txt_art_clinic" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/last_vl_test" />
                        <TextView android:id="@+id/txt_date_last_vl" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/last_vl_result" />
                        <TextView android:id="@+id/txt_vl_last_result" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/next_vl_test" />
                        <TextView android:id="@+id/txt_date_next_vl" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/on_mmd" />
                        <TextView android:id="@+id/txt_child_mmd" style="@style/OverviewRowValue" />
                    </LinearLayout>

                    <include layout="@layout/overview_row_divider" />

                    <LinearLayout style="@style/OverviewRow">
                        <TextView style="@style/OverviewRowLabel" android:text="@string/mmd_level" />
                        <TextView android:id="@+id/txt_level_mmd" style="@style/OverviewRowValue" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============ SIGNATURE ============ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView style="@style/ReportSectionHeader" android:text="@string/signature" />

                    <ImageView
                        android:id="@+id/img_signature"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@drawable/bg_signature_frame"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txt_no_signature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginHorizontal="16dp"
                        android:gravity="center"
                        android:text="@string/no_signature_captured"
                        android:textColor="@color/light_grey_text"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
