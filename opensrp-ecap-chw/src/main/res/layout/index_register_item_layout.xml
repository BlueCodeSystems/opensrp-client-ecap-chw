<?xml version="1.0" encoding="utf-8"?>
<!--
  One child in the VCA (CA) register. IndexRegisterViewHolder binds every id here and sets the status
  stripe, the visit pill's style and the icons. The outlined green pill is the only action; visit
  statuses use soft tinted pills so they never look like a second button.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register_columns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/itemm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:minHeight="88dp"
            android:orientation="horizontal">

            <!-- Case status stripe; IndexRegisterViewHolder colours it from the record's case status -->
            <View
                android:id="@+id/mystatusx"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/reg_status_none" />

            <!-- Child avatar: row_boy / row_girl on a gender-tinted circle -->
            <FrameLayout
                android:id="@+id/gender_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/circle_light_grey"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/gender_image"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/icon_child_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/row_boy" />
            </FrameLayout>

            <!-- Text, chips and the action; the only flexible column, so the row can never overflow -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="4dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/familyNameTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/dash_text"
                        android:textSize="16sp"
                        tools:text="Nega Baby Child" />

                    <TextView
                        android:id="@+id/villageTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:textColor="@color/dash_text_muted"
                        android:textSize="12sp"
                        tools:text="ID 22906804" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gender_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dash_text_secondary"
                    android:textSize="13sp"
                    tools:text="Male · 0y 2m" />

                <!-- This month's visit and the case plan, labelled so a gap is as visible as a tick -->
                <LinearLayout
                    android:id="@+id/ca_indicators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/index_visit"
                        style="@style/CaIndicator"
                        tools:drawableStart="@drawable/ic_service_calendar"
                        tools:text="Visited this month" />

                    <TextView
                        android:id="@+id/index_case_plan"
                        style="@style/CaIndicator"
                        android:layout_marginStart="16dp"
                        tools:drawableStart="@drawable/ic_case_plan"
                        tools:text="Case plan" />
                </LinearLayout>

                <!-- Visit status and Index on the left; visit / case-plan indicators and the action on the right -->
                <LinearLayout
                    android:id="@+id/due_button_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/visit_status"
                            style="@style/ServiceRegisterPill"
                            android:layout_marginEnd="6dp"
                            android:visibility="gone"
                            tools:background="@drawable/reg_pill_warning"
                            tools:text="Visit due 26 Aug 2026"
                            tools:textColor="@color/reg_pill_warning_text"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/index_icon"
                            style="@style/ServiceRegisterPill"
                            android:background="@drawable/reg_chip_index"
                            android:text="Index"
                            android:textColor="@color/primary"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- The three-monthly visit: a quieter text action beside the main one -->
                    <Button
                        android:id="@+id/due_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:hapticFeedbackEnabled="true"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:stateListAnimator="@null"
                        android:text="Conduct visit"
                        android:textAllCaps="false"
                        android:textColor="@color/reg_pill_action_text"
                        android:textSize="12sp" />

                    <!-- Services are monthly, so recording one is the row's main action -->
                    <Button
                        android:id="@+id/record_service"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/reg_pill_action"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:hapticFeedbackEnabled="true"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:stateListAnimator="@null"
                        android:text="Record service"
                        android:textAllCaps="false"
                        android:textColor="@color/reg_pill_action_text"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- No chevron: the whole card opens the profile, as on the other registers -->
            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

        </LinearLayout>

        <!-- Notification bell: dead feature (popup menu code is commented out upstream), kept only so
             IndexRegisterViewHolder's unconditional findViewById/setOnClickListener don't NPE -->
        <LinearLayout
            android:id="@+id/notification_wrapper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/notifications"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_notification" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
