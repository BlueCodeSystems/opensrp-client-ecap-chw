<?xml version="1.0" encoding="utf-8"?>
<!--
  One child in the VCA (CA) register. IndexRegisterViewHolder binds every id here and sets the status
  stripe, the visit pill's style and the icons. The outlined green pill is the only action; visit
  statuses use soft tinted pills so they never look like a second button.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register_columns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/itemm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:orientation="horizontal">

            <!-- Case status stripe; IndexRegisterViewHolder colours it from the record's case status -->
            <View
                android:id="@+id/mystatusx"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/reg_status_none" />

            <!-- Child avatar: row_boy / row_girl on a gender-tinted circle -->
            <FrameLayout
                android:id="@+id/gender_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/circle_light_grey"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/gender_image"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/icon_child_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/row_boy" />
            </FrameLayout>

            <!-- Text and the visit pill; the only flexible column, so the row can never overflow -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="8dp"
                android:paddingBottom="14dp">

                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/familyNameTextView"
                    style="@style/CustomFontTextViewStyle.ClientList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/dash_text"
                    android:textSize="16sp"
                    tools:text="Nega Baby Child" />

                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/gender_age"
                    style="@style/CustomFontTextViewStyle.ClientList.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dash_text_secondary"
                    android:textSize="13sp"
                    tools:text="Male · 0y 2m" />

                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/villageTextView"
                    style="@style/CustomFontTextViewStyle.ClientList.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dash_text_muted"
                    android:textSize="12sp"
                    tools:text="ID: 22906804" />

                <LinearLayout
                    android:id="@+id/due_button_wrapper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/due_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/reg_pill_action"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:hapticFeedbackEnabled="true"
                        android:maxWidth="220dp"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:stateListAnimator="@null"
                        android:text="Conduct Visit"
                        android:textAllCaps="false"
                        android:textColor="@color/reg_pill_action_text"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Index chip and the visit / case-plan indicators -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/index_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/reg_chip_index"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="Index"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Monthly visit: green once a visit is recorded this month, grey otherwise -->
                    <ImageView
                        android:id="@+id/index_visit"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/icon_service_visit_desc"
                        android:src="@drawable/ic_service_calendar"
                        android:tint="@color/stat_pill_unknown"
                        android:visibility="gone" />

                    <!-- Case plan on file -->
                    <ImageView
                        android:id="@+id/index_case_plan"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/icon_case_plan_desc"
                        android:src="@drawable/ic_case_plan"
                        android:tint="@color/primary" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/dash_text_muted" />

        </LinearLayout>

        <!-- Notification bell: dead feature (popup menu code is commented out upstream), kept only so
             IndexRegisterViewHolder's unconditional findViewById/setOnClickListener don't NPE -->
        <LinearLayout
            android:id="@+id/notification_wrapper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/notifications"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_notification" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
