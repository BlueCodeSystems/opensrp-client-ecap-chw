<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- ============ CARE SUMMARY ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/register_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    style="@style/OverviewSectionHeader"
                    android:text="Care Summary" />

                <LinearLayout
                    android:id="@+id/longitudinal_row"
                    style="@style/OverviewRow"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:weightSum="0">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/OverviewRowLabel"
                            android:layout_width="wrap_content"
                            android:text="Longitudinal Follow-ups" />
                        <TextView
                            android:id="@+id/longitudinal_summary"
                            style="@style/OverviewRowValue"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No records yet" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:alpha="0.4"
                        android:contentDescription="@string/not_available"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout
                    android:id="@+id/postnatal_row"
                    style="@style/OverviewRow"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:weightSum="0">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/OverviewRowLabel"
                            android:layout_width="wrap_content"
                            android:text="Postnatal Care" />
                        <TextView
                            android:id="@+id/postnatal_summary"
                            style="@style/OverviewRowValue"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No records yet" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:alpha="0.4"
                        android:contentDescription="@string/not_available"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout
                    android:id="@+id/outcome_row"
                    style="@style/OverviewRow"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:weightSum="0">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/OverviewRowLabel"
                            android:layout_width="wrap_content"
                            android:text="Final Outcome" />
                        <TextView
                            android:id="@+id/outcome_summary"
                            style="@style/OverviewRowValue"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No records yet" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:alpha="0.4"
                        android:contentDescription="@string/not_available"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============ CAREGIVER DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/register_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    style="@style/OverviewSectionHeader"
                    android:text="Caregiver Details" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Caregiver Name" />
                    <TextView android:id="@+id/caregiver_name_value" style="@style/OverviewRowValue" android:text="Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Relationship to Child" />
                    <TextView android:id="@+id/caregiver_relation_value" style="@style/OverviewRowValue" android:text="Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Caregiver Phone" />
                    <TextView android:id="@+id/caregiver_phone_value" style="@style/OverviewRowValue" android:text="Not set" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============ LOCATION & ENROLLMENT ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/register_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    style="@style/OverviewSectionHeader"
                    android:text="Location &amp; Enrollment" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Facility" />
                    <TextView android:id="@+id/facility_value" style="@style/OverviewRowValue" android:text="Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Ward / District" />
                    <TextView android:id="@+id/location_value" style="@style/OverviewRowValue" android:text="Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="School" />
                    <TextView android:id="@+id/school_value" style="@style/OverviewRowValue" android:text="Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Date Enrolled" />
                    <TextView android:id="@+id/enrolled_value" style="@style/OverviewRowValue" android:text="Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Case Status" />
                    <TextView android:id="@+id/case_status_value" style="@style/OverviewRowValue" android:text="Not set" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
