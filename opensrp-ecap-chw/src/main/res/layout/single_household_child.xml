<?xml version="1.0" encoding="utf-8"?>
<!-- A household member, in the register card style. HouseholdChildrenAdapter colours the case-status stripe and
     sets the boy / girl avatar; the inner RelativeLayout is the row the adapter listens to. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp">

    <RelativeLayout
        android:id="@+id/register_columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground">

        <LinearLayout
            android:id="@+id/itemm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="80dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/mycolor"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/reg_status_none" />

            <FrameLayout
                android:id="@+id/child_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/circle_light_grey">

                <ImageView
                    android:id="@+id/child_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/row_boy" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="88dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/child_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/dash_text"
                    android:textSize="16sp"
                    tools:text="Agatha Phiri" />

                <TextView
                    android:id="@+id/child_age_gender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/dash_text_secondary"
                    android:textSize="13sp"
                    tools:text="15 Years · Female" />

                <TextView
                    android:id="@+id/caregiver_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/dash_text_muted"
                    android:textSize="12sp"
                    tools:text="Mother: Amai Phiri" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/index_icon"
            style="@style/ServiceRegisterPill"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="14dp"
            android:background="@drawable/reg_chip_index"
            android:text="Index"
            android:textColor="@color/primary"
            android:visibility="gone"
            tools:visibility="visible" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
