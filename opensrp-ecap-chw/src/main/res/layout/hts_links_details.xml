<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="480dp"
    android:background="@color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp">

        <!-- ============ CONTACT DETAILS ============ -->
        <TextView style="@style/ReportSectionHeader" android:text="@string/contact_details" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/date_linked" />
            <TextView android:id="@+id/date_linked" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/ecap_id" />
            <TextView android:id="@+id/ecap_id" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/sub_population" />
            <TextView android:id="@+id/sub_population" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/age" />
            <TextView android:id="@+id/age" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/relationship" />
            <TextView android:id="@+id/relationship" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/current_address" />
            <TextView android:id="@+id/current_address" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/landmark" />
            <TextView android:id="@+id/landmark" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/phone" />
            <TextView android:id="@+id/phone" style="@style/OverviewRowValue" />
        </LinearLayout>

        <!-- ============ HIV STATUS ============ -->
        <TextView
            style="@style/ReportSectionHeader"
            android:layout_marginTop="8dp"
            android:text="@string/hiv_status_header" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/current_hiv_status" />
            <TextView android:id="@+id/hiv_status" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout
            android:id="@+id/date"
            style="@style/OverviewRow"
            android:visibility="visible">
            <TextView style="@style/OverviewRowLabel" android:text="@string/date_tested" />
            <TextView android:id="@+id/hiv_status_r_nr" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout
            android:id="@+id/label"
            style="@style/OverviewRow"
            android:visibility="visible">
            <TextView style="@style/OverviewRowLabel" android:text="@string/hiv_testing_results" />
            <TextView android:id="@+id/test_results" style="@style/OverviewRowValue" />
        </LinearLayout>

        <!-- ============ ART DETAILS ============ -->
        <TextView
            style="@style/ReportSectionHeader"
            android:layout_marginTop="8dp"
            android:text="@string/art_details" />

        <LinearLayout
            android:id="@+id/artLayout"
            style="@style/OverviewRow"
            android:visibility="visible">
            <TextView android:id="@+id/artNumTxt" style="@style/OverviewRowLabel" android:text="@string/art_number" />
            <TextView android:id="@+id/art_number" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout
            android:id="@+id/enrolled_on_ARTLayout"
            style="@style/OverviewRow"
            android:visibility="gone">
            <TextView style="@style/OverviewRowLabel" android:text="@string/date_enrolled_on_art" />
            <TextView android:id="@+id/date_enrolled_on_ART" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout
            android:id="@+id/initial_artLayout"
            style="@style/OverviewRow"
            android:visibility="gone">
            <TextView style="@style/OverviewRowLabel" android:text="@string/date_initiated_on_art" />
            <TextView android:id="@+id/initial_art_date" style="@style/OverviewRowValue" />
        </LinearLayout>

        <!-- ============ NOTES ============ -->
        <TextView
            style="@style/ReportSectionHeader"
            android:layout_marginTop="8dp"
            android:text="@string/notes" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/comment" />
            <TextView android:id="@+id/comment" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/case_worker_name" />
            <TextView android:id="@+id/caseworker_name" style="@style/OverviewRowValue" />
        </LinearLayout>

        <include layout="@layout/overview_row_divider" />

        <LinearLayout style="@style/OverviewRow">
            <TextView style="@style/OverviewRowLabel" android:text="@string/checked_by" />
            <TextView android:id="@+id/checked_by" style="@style/OverviewRowValue" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
