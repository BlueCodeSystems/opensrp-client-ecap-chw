<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/main_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/default_left_margin"
            android:paddingEnd="@dimen/default_right_margin"
            android:paddingTop="8dp">

        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottom_navigation_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end">

        <Button
            android:id="@+id/next_button"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bottom_navigation_margin"
            android:layout_marginRight="@dimen/bottom_navigation_margin"
            android:layout_marginBottom="32dp"
            android:background="@android:color/transparent"
            android:paddingStart="@dimen/bottom_navigation_padding"
            android:paddingEnd="@dimen/bottom_navigation_padding"
            android:text="@string/next"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.AppCompat.Button"
            android:textColor="#2196F3"
            android:textSize="20sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>