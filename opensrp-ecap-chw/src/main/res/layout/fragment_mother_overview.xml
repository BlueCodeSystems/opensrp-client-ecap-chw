<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overview_summary_row"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- ============ ENROLLMENT DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/overview_section_header"
                    style="@style/OverviewSectionHeader"
                    android:text="Enrollment Details" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Household ID" />
                    <TextView android:id="@+id/hh_id" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/overview_section_details_left1"
                        style="@style/OverviewRowLabel"
                        android:text="Physical Address" />
                    <TextView
                        android:id="@+id/p_address"
                        style="@style/OverviewRowValue"
                        android:inputType="textCapWords" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Phone Number" />
                    <TextView
                        android:id="@+id/phone"
                        style="@style/OverviewRowValue"
                        android:textAllCaps="false" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Facility" />
                    <TextView
                        android:id="@+id/facility"
                        style="@style/OverviewRowValue"
                        android:textAllCaps="false" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Screening Date" />
                    <TextView
                        android:id="@+id/screening_date"
                        style="@style/OverviewRowValue"
                        android:textAllCaps="false" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ HEALTH DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/overview_section_header2"
                    style="@style/OverviewSectionHeader"
                    android:text="Health Details" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="HIV Status" />
                    <TextView
                        android:id="@+id/hiv_status"
                        style="@style/OverviewRowValue"
                        android:textAllCaps="false" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Pregnant" />
                    <TextView
                        android:id="@+id/pregnant_status"
                        style="@style/OverviewRowValue"
                        android:textAllCaps="false" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Breastfeeding" />
                    <TextView
                        android:id="@+id/breastfeeding_status"
                        style="@style/OverviewRowValue"
                        android:textAllCaps="false" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout
                    android:id="@+id/treatment_row"
                    style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/case_status_overview"
                        style="@style/OverviewRowLabel"
                        android:text="Active on Treatment" />
                    <TextView
                        android:id="@+id/treatment"
                        style="@style/OverviewRowValue"
                        android:inputType="textCapWords" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout
                    android:id="@+id/art_row"
                    style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="ART Number" />
                    <TextView
                        android:id="@+id/art_number"
                        style="@style/OverviewRowValue"
                        android:textAllCaps="false" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
