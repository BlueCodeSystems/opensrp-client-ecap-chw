<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overview_summary_row"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- ============ ENROLLMENT DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/overview_section_header"
                    style="@style/OverviewSectionHeader"
                    android:text="Enrollment Details" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Household ID" />
                    <TextView android:id="@+id/hh_id" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/overview_section_details_left1"
                        style="@style/OverviewRowLabel"
                        android:text="Physical Address" />
                    <TextView
                        android:id="@+id/p_address"
                        style="@style/OverviewRowValue"
                        android:inputType="textCapWords" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Phone Number" />
                    <TextView
                        android:id="@+id/phone"
                        style="@style/OverviewRowValue"
                        android:textAllCaps="true" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/case_status_overview"
                        style="@style/OverviewRowLabel"
                        android:text="Date enrolled in the PMTCT" />
                    <TextView
                        android:id="@+id/pmtct_date_enrolled"
                        style="@style/OverviewRowValue"
                        android:inputType="textCapWords" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ LABOUR DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/overview_section_header_anc"
                    style="@style/OverviewSectionHeader"
                    android:text="Labour Details" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Date of Delivery" />
                    <TextView android:id="@+id/date_of_delivery" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/overview_section_details_hiv_test"
                        style="@style/OverviewRowLabel"
                        android:text="Place of delivery" />
                    <TextView
                        android:id="@+id/place_of_delivery"
                        style="@style/OverviewRowValue"
                        android:inputType="textCapWords" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="On art at time of delivery" />
                    <TextView
                        android:id="@+id/on_art_at_time_of_delivery"
                        style="@style/OverviewRowValue"
                        android:textAllCaps="true" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
