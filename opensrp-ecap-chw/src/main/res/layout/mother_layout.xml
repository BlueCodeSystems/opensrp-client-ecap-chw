<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/register_columns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/itemm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal">

        <!-- Left: avatar + child count badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/gender_image"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mother"
                android:contentDescription="Mother Icon"
              />

            <!-- Small circle with number of children -->
            <TextView
                android:id="@+id/childrenCountTextView"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/ic_children"
                android:gravity="center"
                android:text="3"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Right: main text content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1: name + age + case status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/motherNameTextView"
                    style="@style/CustomFontTextViewStyle.ClientList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Mother Name"
                    android:textColor="@color/text_black"
                    android:textSize="18sp" />

                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/motherAgeTextView"
                    style="@style/CustomFontTextViewStyle.ClientList.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="32 yrs"
                    android:textColor="@color/light_grey_text"
                    android:textSize="14sp" />

                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/caseStatusTextView"
                    style="@style/CustomFontTextViewStyle.ClientList.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/case_status_background"
                    android:text="Active"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Row 2: children summary (count + age band) -->
            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/childrenTextView"
                style="@style/CustomFontTextViewStyle.ClientList.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="3 children • 0–15m, 16–24m"
                android:textColor="@color/light_grey_text"
                android:textSize="14sp" />

            <!-- Row 3: facility -->
            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/facilityTextView"
                style="@style/CustomFontTextViewStyle.ClientList.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Kanyama Clinic"
                android:textColor="@color/light_grey_text"
                android:textSize="14sp" />

            <!-- Row 4: date referred -->
            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/referralDateTextView"
                style="@style/CustomFontTextViewStyle.ClientList.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Referred: 12 Jan 2025"
                android:textColor="@color/light_grey_text"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
