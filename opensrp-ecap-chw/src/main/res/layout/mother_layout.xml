<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register_columns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main row -->
        <LinearLayout
            android:id="@+id/itemm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="88dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left accent strip -->
            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/reg_status_none" />

            <!-- Mother avatar -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/circle_light_grey"
                android:backgroundTint="@color/register_mother_bg">

                <ImageView
                    android:id="@+id/gender_image"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mother_holding_baby"
                    app:tint="@color/register_mother_icon"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/icon_mother_desc" />
            </FrameLayout>

            <!-- Center: text content; the only flexible-width column, so this row can never overflow the screen -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Row 1: name + age -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <org.smartregister.view.customcontrols.CustomFontTextView
                        android:id="@+id/motherNameTextView"
                        style="@style/CustomFontTextViewStyle.ClientList"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/dash_text"
                        android:textSize="16sp"
                        tools:text="Mother Name"
                        android:fontFamily="sans-serif-medium"/>

                    <org.smartregister.view.customcontrols.CustomFontTextView
                        android:id="@+id/motherAgeTextView"
                        style="@style/CustomFontTextViewStyle.ClientList.Light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/dash_text_secondary"
                        android:textSize="13sp"
                        tools:text="32 yrs" />

                </LinearLayout>

                <!-- Row 2: children summary -->
                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/childrenTextView"
                    style="@style/CustomFontTextViewStyle.ClientList.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/dash_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="3 children" />

                <!-- Row 3: household / facility -->
                <org.smartregister.view.customcontrols.CustomFontTextView
                    android:id="@+id/facilityTextView"
                    style="@style/CustomFontTextViewStyle.ClientList.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/dash_text_secondary"
                    android:textSize="12sp"
                    tools:text="Kanyama Clinic" />

            </LinearLayout>

            <!-- Chevron -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null"
                app:tint="@color/dash_text_muted"/>

        </LinearLayout>

        <!-- Thin divider before footer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dash_divider" />

        <!-- Footer: last interaction / enrollment date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_calender"
                android:contentDescription="@null"
                app:tint="@color/dash_text_muted" />

            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/referralDateTextView"
                style="@style/CustomFontTextViewStyle.ClientList.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/dash_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                tools:text="Enrolled: 12 Jan 2025" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
