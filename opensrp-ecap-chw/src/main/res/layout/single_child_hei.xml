<?xml version="1.0" encoding="utf-8"?>
<!--
    HEI (HIV-Exposed Infant) row card, used by PmctMotherHeiAdapter.
    Root MUST stay a RelativeLayout with id register_columns:
    PmctMotherHeiAdapter.ViewHolder does
        relativeLayout = itemView.findViewById(R.id.register_columns);
    with a RelativeLayout-typed field, so changing the root to CardView
    (or any non-RelativeLayout view) would throw a ClassCastException
    at runtime. The "card" look below is achieved with a rounded
    background drawable + elevation instead of an actual CardView.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/register_columns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_hei_row_card"
    android:elevation="2dp"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/itemm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingEnd="12dp">

        <!-- Left status stripe for HEI risk -->
        <View
            android:id="@+id/hei_status_stripe"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_status_stripe" />

        <!-- Circular avatar backdrop for gender icon -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_hei_icon_circle">

            <ImageView
                android:id="@+id/gender_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/child_boy_infant"
                android:contentDescription="@string/not_available" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/familyNameTextView"
                style="@style/CustomFontTextViewStyle.ClientList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Patient Name"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/child_age"
                style="@style/CustomFontTextViewStyle.ClientList.Light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Age : 5"
                android:textColor="@color/light_grey_text"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Status chips: high risk / HIV positive flags -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <Button
                android:id="@+id/hei_high_risk_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_warning"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:stateListAnimator="@null"
                android:text="@string/hei_high_risk_flag"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="6dp" />

            <Button
                android:id="@+id/hei_hiv_positive_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_danger"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:stateListAnimator="@null"
                android:text="@string/hei_hiv_positive_flag"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- Inline unsuppressed-VL alert panel (collapsed by default) -->
    <include
        android:id="@+id/hei_unsuppressed_alert"
        layout="@layout/view_pmtct_unsuppressed_vl_child"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/itemm"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <!-- Inline HIV-positive alert panel (collapsed by default) -->
    <include
        android:id="@+id/hei_hiv_positive_alert"
        layout="@layout/view_hei_alert_hiv_positive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/hei_unsuppressed_alert"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

</RelativeLayout>
