<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/partner_logos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/login_horizontal_margin"
    android:paddingRight="@dimen/login_horizontal_margin">

    <ImageView
        android:id="@+id/opensrp_logo_image_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/login_partner_logo_height"
        android:layout_weight="1"
        android:contentDescription="@string/partner_coat_of_arms"
        android:scaleType="fitCenter"
        android:src="@drawable/partner_coat_of_arms" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="@dimen/login_partner_logo_height"
        android:layout_weight="1"
        android:contentDescription="@string/partner_us_flag"
        android:scaleType="fitCenter"
        android:src="@drawable/partner_us_flag" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="@dimen/login_partner_logo_height"
        android:layout_weight="1"
        android:contentDescription="@string/partner_pcz_logo"
        android:scaleType="fitCenter"
        android:src="@drawable/partner_pcz_logo" />

</LinearLayout>
