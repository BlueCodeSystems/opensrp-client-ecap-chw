<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg"
    tools:context=".activity.DashboardActivity">

    <!-- APP BAR / HEADER -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/collapsing_toolbar_appbarlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarx"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

            <LinearLayout
                android:id="@+id/profile_name_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/actionBarSize"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="1.5">

                <TextView
                    android:id="@+id/dash_facility_name"
                    style="@style/CustomFontTextViewStyle.ClientList.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Facility name"
                    android:textAllCaps="false"
                    android:textColor="@color/card_text_primary"
                    android:textSize="22sp"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Children/Adolescents Dashboard"
                    android:textSize="13sp"
                    android:textColor="@color/card_text_secondary" />

                <!-- Last updated pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill_translucent"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Updated:"
                        android:textSize="11sp"
                        android:textColor="@color/card_text_secondary" />

                    <org.smartregister.view.customcontrols.CustomFontTextView
                        android:id="@+id/last_updated"
                        style="@style/CustomFontTextViewStyle.ClientList.Light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="--"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/card_text_primary" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- FILTER ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View:"
                    android:textSize="13sp"
                    android:textColor="@color/light_grey_text" />

                <Switch
                    android:id="@+id/information_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:showText="true"
                    android:textOff="All CA"
                    android:textOn="Only my CA"
                    tools:ignore="TouchTargetSizeCheck" />

            </LinearLayout>

            <!-- KPI CARDS ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Children / Adolescents -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_view1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/dash_card_gap"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="@dimen/dash_card_radius"
                    app:cardElevation="@dimen/dash_card_elevation"
                    app:cardBackgroundColor="@android:color/transparent">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="@dimen/dash_card_min_height"
                        android:background="@drawable/bg_card_children">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <FrameLayout
                                android:layout_width="@dimen/dash_icon_circle"
                                android:layout_height="@dimen/dash_icon_circle"
                                android:background="@drawable/bg_icon_circle_white"
                                android:layout_marginBottom="4dp">

                                <ImageView
                                    android:id="@+id/icon_children"
                                    android:layout_width="@dimen/dash_icon_size"
                                    android:layout_height="@dimen/dash_icon_size"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_children"
                                    app:tint="@color/card_text_primary" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/allVcasNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/card_text_primary"
                                android:textSize="@dimen/dash_kpi_number"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/info_text1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Children / Adolescents"
                                android:textSize="@dimen/dash_card_label"
                                android:textColor="@color/card_text_secondary"
                                android:gravity="center" />

                            <!-- Gender breakdown inside card -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/dash_card_sublabel"
                                    android:textColor="@color/card_text_tertiary"
                                    android:text="M" />

                                <TextView
                                    android:id="@+id/card_male_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:text="0"
                                    android:textSize="@dimen/dash_card_label"
                                    android:textStyle="bold"
                                    android:textColor="@color/card_text_primary" />

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@color/card_text_tertiary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/dash_card_sublabel"
                                    android:textColor="@color/card_text_tertiary"
                                    android:text="F" />

                                <TextView
                                    android:id="@+id/card_female_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:text="0"
                                    android:textSize="@dimen/dash_card_label"
                                    android:textStyle="bold"
                                    android:textColor="@color/card_text_primary" />

                            </LinearLayout>

                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="6dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_navigate_next_black_24dp"
                            app:tint="@color/card_text_tertiary" />

                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Households -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_view2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dash_card_gap"
                    android:layout_marginEnd="@dimen/dash_card_gap"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="@dimen/dash_card_radius"
                    app:cardElevation="@dimen/dash_card_elevation"
                    app:cardBackgroundColor="@android:color/transparent">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="@dimen/dash_card_min_height"
                        android:background="@drawable/bg_card_households">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <FrameLayout
                                android:layout_width="@dimen/dash_icon_circle"
                                android:layout_height="@dimen/dash_icon_circle"
                                android:background="@drawable/bg_icon_circle_white"
                                android:layout_marginBottom="6dp">

                                <ImageView
                                    android:id="@+id/icon_households"
                                    android:layout_width="@dimen/dash_icon_size"
                                    android:layout_height="@dimen/dash_icon_size"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_household"
                                    app:tint="@color/card_text_primary" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/allHouseholdsNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/card_text_primary"
                                android:textSize="@dimen/dash_kpi_number"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/allHouseholdsTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Households"
                                android:textSize="@dimen/dash_card_label"
                                android:textColor="@color/card_text_secondary" />

                            <!-- Caregiver gender breakdown -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/dash_card_sublabel"
                                    android:textColor="@color/card_text_tertiary"
                                    android:text="M" />

                                <TextView
                                    android:id="@+id/card_caregiver_male_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:text="0"
                                    android:textSize="@dimen/dash_card_label"
                                    android:textStyle="bold"
                                    android:textColor="@color/card_text_primary" />

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@color/card_text_tertiary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/dash_card_sublabel"
                                    android:textColor="@color/card_text_tertiary"
                                    android:text="F" />

                                <TextView
                                    android:id="@+id/card_caregiver_female_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:text="0"
                                    android:textSize="@dimen/dash_card_label"
                                    android:textStyle="bold"
                                    android:textColor="@color/card_text_primary" />

                            </LinearLayout>

                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="6dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_navigate_next_black_24dp"
                            app:tint="@color/card_text_tertiary" />

                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Due Visits -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/due_card_view"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dash_card_gap"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/dash_card_radius"
                    app:cardElevation="@dimen/dash_card_elevation"
                    app:cardBackgroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="@dimen/dash_card_min_height"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <FrameLayout
                            android:layout_width="@dimen/dash_icon_circle"
                            android:layout_height="@dimen/dash_icon_circle"
                            android:background="@drawable/bg_icon_circle_white"
                            android:layout_marginBottom="6dp">

                            <ImageView
                                android:id="@+id/icon_due_visits"
                                android:layout_width="@dimen/dash_icon_size"
                                android:layout_height="@dimen/dash_icon_size"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_calender"
                                app:tint="@color/card_text_primary"
                                tools:ignore="UseAppTint" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/due_visits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/card_text_primary"
                            android:textSize="@dimen/dash_kpi_number"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/due_visits_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Due visits"
                            android:textSize="@dimen/dash_card_label"
                            android:textColor="@color/card_text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="This month"
                            android:textSize="@dimen/dash_card_sublabel"
                            android:textColor="@color/card_text_tertiary" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- GRAPH SECTION -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="@dimen/dash_card_radius"
                app:cardElevation="@dimen/dash_card_elevation"
                app:cardBackgroundColor="@color/chart_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Section title row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="36dp"
                            android:background="@color/card_children_start" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Subpopulation in Facility"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Children and Adolescents by subpopulation group"
                                android:textSize="12sp"
                                android:textColor="@color/light_grey_text" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Hidden time range control -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time range:"
                            android:textSize="12sp"
                            android:textColor="@color/light_grey_text" />

                        <Spinner
                            android:id="@+id/time_range_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/divider_grey" />

                    <!-- Chart container -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:layout_marginTop="8dp">

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/fragment_verticalbarchart_chart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <ProgressBar
                            android:id="@+id/dash_progressbar"
                            style="?android:attr/progressBarStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chart_empty_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="No data available for the selected period."
                            android:textSize="13sp"
                            android:textColor="@color/light_grey_text"
                            android:visibility="gone" />

                    </FrameLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- REGISTERS SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Other Registers"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_black" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dash_card_radius"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/register_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. Mother Index Register -->
                    <LinearLayout
                        android:id="@+id/register_row_mother"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/register_row_vertical_padding"
                        android:paddingBottom="@dimen/register_row_vertical_padding"
                        android:paddingStart="@dimen/register_row_horizontal_padding"
                        android:paddingEnd="@dimen/register_row_horizontal_padding">

                        <FrameLayout
                            android:layout_width="@dimen/register_icon_size"
                            android:layout_height="@dimen/register_icon_size"
                            android:background="@drawable/bg_register_icon"
                            android:backgroundTint="@color/register_mother_bg">

                            <ImageView
                                android:layout_width="@dimen/register_icon_inner"
                                android:layout_height="@dimen/register_icon_inner"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mother"
                                app:tint="@color/register_mother_icon" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mother Index"
                                android:textSize="14sp"
                                android:textColor="@color/text_black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Enrolled mothers"
                                android:textSize="11sp"
                                android:textColor="@color/light_grey_text" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/register_mother_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/register_mother_icon" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_navigate_next_black_24dp"
                            app:tint="@color/light_grey_text" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="66dp"
                        android:background="@color/divider_grey" />

                    <!-- 2. HTS Register -->
                    <LinearLayout
                        android:id="@+id/register_row_hts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/register_row_vertical_padding"
                        android:paddingBottom="@dimen/register_row_vertical_padding"
                        android:paddingStart="@dimen/register_row_horizontal_padding"
                        android:paddingEnd="@dimen/register_row_horizontal_padding">

                        <FrameLayout
                            android:layout_width="@dimen/register_icon_size"
                            android:layout_height="@dimen/register_icon_size"
                            android:background="@drawable/bg_register_icon"
                            android:backgroundTint="@color/register_hts_bg">

                            <ImageView
                                android:layout_width="@dimen/register_icon_inner"
                                android:layout_height="@dimen/register_icon_inner"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_baseline_content_paste_24"
                                app:tint="@color/register_hts_icon" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HTS Register"
                                android:textSize="14sp"
                                android:textColor="@color/text_black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="HIV Testing Services"
                                android:textSize="11sp"
                                android:textColor="@color/light_grey_text" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/register_hts_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/register_hts_icon" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_navigate_next_black_24dp"
                            app:tint="@color/light_grey_text" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="66dp"
                        android:background="@color/divider_grey" />

                    <!-- 3. PMTCT Register -->
                    <LinearLayout
                        android:id="@+id/register_row_pmtct"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/register_row_vertical_padding"
                        android:paddingBottom="@dimen/register_row_vertical_padding"
                        android:paddingStart="@dimen/register_row_horizontal_padding"
                        android:paddingEnd="@dimen/register_row_horizontal_padding">

                        <FrameLayout
                            android:layout_width="@dimen/register_icon_size"
                            android:layout_height="@dimen/register_icon_size"
                            android:background="@drawable/bg_register_icon"
                            android:backgroundTint="@color/register_pmtct_bg">

                            <ImageView
                                android:layout_width="@dimen/register_icon_inner"
                                android:layout_height="@dimen/register_icon_inner"
                                android:layout_gravity="center"
                                android:src="@drawable/baseline_woman_24"
                                app:tint="@color/register_pmtct_icon" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PMTCT Register"
                                android:textSize="14sp"
                                android:textColor="@color/text_black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Prevention of Mother-to-Child Transmission"
                                android:textSize="11sp"
                                android:textColor="@color/light_grey_text" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/register_pmtct_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/register_pmtct_icon" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_navigate_next_black_24dp"
                            app:tint="@color/light_grey_text" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

