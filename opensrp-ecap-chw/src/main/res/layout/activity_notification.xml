<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".activity.NotificationActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarnotifications"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/myrecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <RelativeLayout
            android:id="@+id/service_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible">

            <ImageView
                android:id="@+id/empty_icon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerHorizontal="true"
                android:contentDescription="@string/not_available"
                android:src="@drawable/icon_notasks" />

            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/no_services_due"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/empty_icon"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="No visits due"
                android:textColor="@color/text_black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <org.smartregister.view.customcontrols.CustomFontTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/no_services_due"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="32dp"
                android:gravity="center"
                android:text="You're all caught up — nothing needs attention right now."
                android:textColor="@color/light_grey_text"
                android:textSize="14sp" />

        </RelativeLayout>

    </FrameLayout>

</LinearLayout>
