<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pmtct_alert_unsuppressed_vl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardUseCompatPadding="false"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Left danger stripe indicating a flagged case -->
        <View
            android:id="@+id/stripe"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="@color/colorRed"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Header: warning icon + title, with a red Flagged chip on the right -->
        <ImageView
            android:id="@+id/iv_warning"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/pmtct_alert_unsuppressed_title"
            android:src="@drawable/ic_icon_warning"
            app:layout_constraintStart_toEndOf="@id/stripe"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorRed" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="HEI (HIV-Exposed Infant) Identified as High Risk"
            android:textColor="@color/text_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iv_warning"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chip_flagged"
            app:layout_constraintHorizontal_bias="0"/>

        <TextView
            android:id="@+id/chip_flagged"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/pmtct_alert_flagged"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:background="@drawable/bg_chip_danger"
            app:layout_constraintEnd_toStartOf="@+id/btn_close_alert"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Close button for inline alert -->
        <ImageView
            android:id="@+id/btn_close_alert"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="2dp"
            android:contentDescription="Close"
            android:src="@drawable/outline_close_24"
            android:tint="@color/light_grey_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Actions header -->
        <TextView
            android:id="@+id/tv_actions_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pmtct_alert_unsuppressed_actions_header"
            android:textColor="@color/text_black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/stripe"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Recommended actions (bulleted) -->
        <TextView
            android:id="@+id/tv_actions_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/pmtct_alert_unsuppressed_actions_bullets_child"
            android:textColor="@color/light_grey_text"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tv_actions_header"
            app:layout_constraintTop_toBottomOf="@id/tv_actions_header"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
