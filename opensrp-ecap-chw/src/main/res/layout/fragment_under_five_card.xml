<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- ============ CHILD DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    style="@style/OverviewSectionHeader"
                    android:text="Child Details" />

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/imageview_profile"
                    android:src="@drawable/child_girl_infant"
                    android:layout_width="@dimen/client_profile_pic_width"
                    android:layout_height="@dimen/client_profile_pic_height"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    app:civ_border_color="@color/register_hei_gradient_start"
                    app:civ_border_width="2dp" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/card_number"
                        style="@style/OverviewRowValue"
                        android:layout_weight="0"
                        android:layout_width="match_parent"
                        android:text="Under 5 Card Number: Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/child_dob"
                        style="@style/OverviewRowValue"
                        android:layout_weight="0"
                        android:layout_width="match_parent"
                        android:text="Date of Birth: Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/child_weight"
                        style="@style/OverviewRowValue"
                        android:layout_weight="0"
                        android:layout_width="match_parent"
                        android:text="Weight at Birth: Not set" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView
                        android:id="@+id/infant_feeding_option"
                        style="@style/OverviewRowValue"
                        android:layout_weight="0"
                        android:layout_width="match_parent"
                        android:text="Infant Feeding Option: Not set" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ RECENT CHILD MONITORING DETAILS ============ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/register_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    style="@style/OverviewSectionHeader"
                    android:text="Recent Child Monitoring Details" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Pediatric Follow Up Visit" />
                    <TextView android:id="@+id/pediatic_visit" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Date" />
                    <TextView android:id="@+id/pediatic_date" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="HIV Status" />
                    <TextView android:id="@+id/hiv_status_r_nr" style="@style/OverviewRowValue" />
                </LinearLayout>

                <include layout="@layout/overview_row_divider" />

                <LinearLayout style="@style/OverviewRow">
                    <TextView style="@style/OverviewRowLabel" android:text="Next DBS Due" />
                    <TextView
                        android:id="@+id/next_dbs_due"
                        style="@style/OverviewRowValue"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
