<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    tools:context=".activity.MotherDetail">


        <!-- APP BAR + MOTHER PROFILE HEADER -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/collapsing_toolbar_appbarlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/profile_mother_header"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:elevation="4dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/profile_mother_header"
                app:contentScrim="@color/profile_mother_header"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbarx"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:layout_collapseMode="pin"
                    app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

                <LinearLayout
                    android:id="@+id/profile_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/actionBarSize"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="1.5">

                    <!-- Kept for MotherDetail; the profile reads as one header now, so the card is a plain frame -->
                    <FrameLayout
                        android:id="@+id/mother_profile_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/profile_household_avatar">

                                <ImageView
                                    android:id="@+id/mother_avatar"
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_mother_holding_baby"
                                    app:tint="@color/white" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/mother_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Hope Chanda"
                                android:textColor="@color/white"
                                android:textSize="24sp" />

                            <!-- Status, age and household ID as pills -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/mother_status"
                                    style="@style/ProfileHeaderPill"
                                    android:background="@drawable/profile_status_pill"
                                    android:text="Active"
                                    android:textColor="@color/profile_mother_header" />

                                <TextView
                                    android:id="@+id/mother_age"
                                    style="@style/ProfileHeaderPill"
                                    android:layout_marginStart="8dp"
                                    android:text="32" />

                                <TextView
                                    android:id="@+id/household_id"
                                    style="@style/ProfileHeaderPill"
                                    android:layout_marginStart="8dp"
                                    android:text="ID: 00123" />
                            </LinearLayout>

                            <!-- Facility, last ANC and EDD in one quiet line -->
                            <LinearLayout
                                android:id="@+id/profile_footer_row"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/mother_facility"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.85"
                                    android:text="Chipata Clinic"
                                    android:textColor="@color/white"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/mother_last_visit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:alpha="0.85"
                                    android:text="Last ANC: 12 Aug 2025"
                                    android:textColor="@color/white"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/mother_next_appointment"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:alpha="0.85"
                                    android:text="EDD: 10 Feb 2026"
                                    android:textColor="@color/white"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/profile_buttons_row"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:layout_marginBottom="18dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/hh_prof"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/profile_header_button"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:fontFamily="sans-serif-medium"
                                    android:onClick="onClick"
                                    android:paddingStart="@dimen/profile_btn_registration_info_padding"
                                    android:paddingTop="9dp"
                                    android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                                    android:paddingBottom="9dp"
                                    android:text="Household Profile"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/pmtct_prof"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:background="@drawable/profile_header_button"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:fontFamily="sans-serif-medium"
                                    android:onClick="onClick"
                                    android:paddingStart="@dimen/profile_btn_registration_info_padding"
                                    android:paddingTop="9dp"
                                    android:paddingEnd="@dimen/profile_btn_registration_info_padding"
                                    android:paddingBottom="9dp"
                                    android:text="@string/pmtct_services"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <!-- No longer shown: the status pill says what this label used to -->
                            <TextView
                                android:id="@+id/mother_profile_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />
                        </LinearLayout>
                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <!-- Tabs on a white strip, divided from the records below -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                app:tabContentStart="0dp"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/profile_mother_header"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="3dp"
                app:tabMaxWidth="0dp"
                app:tabMode="scrollable"
                app:tabRippleColor="@color/dash_divider"
                app:tabSelectedTextColor="@color/dash_text"
                app:tabTextAppearance="@style/CustomFontTextViewStyle.tabIndicator.sub.white"
                app:tabTextColor="@color/dash_text_secondary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dash_divider" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- MAIN CONTENT -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Overlay for the action menu; a direct sibling so the header can collapse as the tabs scroll -->
    <RelativeLayout
        android:id="@+id/activity_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/fab_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <!-- MENU BAR (Mother & Child actions as small professional chips) -->
        <LinearLayout
            android:id="@+id/menu_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/fabx"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Mother actions -->

            <RelativeLayout
                android:id="@+id/mother_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <TextView
                    android:id="@+id/add_mother"
                    style="@style/MotherActionChip"
                    android:layout_toStartOf="@+id/callFab3"
                    android:text="Edit Mother" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFab3"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@drawable/baseline_mode_edit_24" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mother_anc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mother_anc_text"
                    style="@style/MotherActionChip"
                    android:layout_toStartOf="@+id/mother_anc_fab"
                    android:text="Mother ANC" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mother_anc_fab"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mother_longitudinal_follow_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mother_longitudinal_follow_up_text"
                    style="@style/MotherActionChip"
                    android:layout_toStartOf="@+id/mother_longitudinal_follow_up_fab"
                    android:text="Mother Longitudinal Follow Up" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mother_longitudinal_follow_up_fab"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mother_delivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mother_delivery_text"
                    style="@style/MotherActionChip"
                    android:layout_toStartOf="@+id/mother_delivery_fab"
                    android:text="Mother Delivery" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mother_delivery_fab"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <!-- Child actions -->

            <RelativeLayout
                android:id="@+id/child_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <TextView
                    android:id="@+id/add_child"
                    style="@style/MotherActionChip"
                    android:layout_toStartOf="@+id/callFab2"
                    android:text="Add Child" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFab2"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mother_postnatal_care"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mother_postnatal_care_text"
                    style="@style/MotherActionChip"
                    android:layout_toStartOf="@+id/mother_postnatal_care_fab"
                    android:text="Mother Postnatal Care" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mother_postnatal_care_fab"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mother_outcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mother_outcome_text"
                    style="@style/MotherActionChip"
                    android:layout_toStartOf="@+id/mother_outcome_fab"
                    android:text="Mother Outcome" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mother_outcome_fab"
                    style="@style/MotherActionMiniFab"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

        </LinearLayout>

        <!-- MAIN FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:onClick="onClick"
            android:tint="@android:color/white"
            app:backgroundTint="@color/register_mother_icon"
            app:fabSize="normal"
            app:srcCompat="@drawable/baseline_mode_edit_24" />

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
