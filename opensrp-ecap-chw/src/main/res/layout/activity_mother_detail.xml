<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".activity.MotherDetail">

    <RelativeLayout
        android:id="@+id/activity_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- APP BAR + MOTHER PROFILE HEADER -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/collapsing_toolbar_appbarlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#6CB1A1"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:elevation="4dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="#D6E9D6"
                android:background="#739273"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:titleEnabled="false">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbarx"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:layout_collapseMode="pin"
                    app:theme="@style/ThemeOverlay.AppCompat.Light" />

                <!-- Mother profile header area -->
                <LinearLayout
                    android:id="@+id/profile_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/actionBarSize"
                    android:background="#EAFBF7"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="20dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="1.5">

                    <!-- Card-style profile block -->
                    <!-- Card-style mother profile block -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/mother_profile_card"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="3dp"
                        app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Top row: label + status -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- "Mother profile" label -->
                                <TextView
                                    android:id="@+id/mother_profile_label"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:alpha="0.7"
                                    android:letterSpacing="0.08"
                                    android:text="Mother Profile"
                                    android:textAllCaps="true"
                                    android:textColor="@color/text_black"
                                    android:textSize="11sp" />

                                <!-- Optional status pill (e.g. Active / Completed ANC) -->
                                <TextView
                                    android:id="@+id/mother_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="#739273"
                                    android:paddingStart="8dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="2dp"
                                    android:singleLine="true"
                                    android:text="Active"
                                    android:textColor="@android:color/white"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Row: avatar + main info -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- Circular avatar -->
                                <ImageView
                                    android:id="@+id/mother_avatar"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_marginEnd="16dp"
                                    android:background="@drawable/circle_white_24"
                                    android:padding="10dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/ic_person" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <!-- Name -->
                                    <org.smartregister.view.customcontrols.CustomFontTextView
                                        android:id="@+id/mother_name"
                                        style="@style/CustomFontTextViewStyle.ClientList.Medium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Hope Chanda"
                                        android:textColor="@color/text_black"
                                        android:textSize="@dimen/activity_title_size" />

                                    <!-- Age + ID row -->
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:orientation="horizontal">

                                        <org.smartregister.view.customcontrols.CustomFontTextView
                                            style="@style/CustomFontTextViewStyle.ClientList.Light"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Age: "
                                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                            android:textColor="@color/text_black" />

                                        <org.smartregister.view.customcontrols.CustomFontTextView
                                            android:id="@+id/mother_age"
                                            style="@style/CustomFontTextViewStyle.ClientList.Light"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="32"
                                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                            android:textColor="@color/text_black" />

                                        <!-- Small separator dot -->
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="6dp"
                                            android:layout_marginEnd="6dp"
                                            android:alpha="0.5"
                                            android:text="•"
                                            android:textColor="@color/text_black" />

                                        <!-- Optional ID / folder number -->
                                        <org.smartregister.view.customcontrols.CustomFontTextView
                                            android:id="@+id/household_id"
                                            style="@style/CustomFontTextViewStyle.ClientList.Light"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:alpha="0.9"
                                            android:text="ID: 00123"
                                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                            android:textColor="@color/text_black" />
                                    </LinearLayout>

                                    <!-- Extra info line (G/P, village/facility) -->
                                    <org.smartregister.view.customcontrols.CustomFontTextView
                                        android:id="@+id/mother_facility"
                                        style="@style/CustomFontTextViewStyle.ClientList.Light"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:alpha="0.8"
                                        android:text="Chipata Clinic"
                                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                        android:textColor="@color/text_black" />

                                </LinearLayout>
                            </LinearLayout>

                            <!-- Optional footer: quick actions / tags -->
                            <LinearLayout
                                android:id="@+id/profile_footer_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="start"
                                android:orientation="horizontal">

                                <!-- Last visit -->
                                <TextView
                                    android:id="@+id/mother_last_visit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Last ANC: 12 Aug 2025"
                                    android:textColor="@android:color/darker_gray"
                                    android:textSize="11sp" />

                                <!-- Separator dot -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_marginEnd="6dp"
                                    android:text="•"
                                    android:textColor="@android:color/darker_gray"
                                    android:textSize="11sp" />

                                <!-- Next appointment / EDD -->
                                <TextView
                                    android:id="@+id/mother_next_appointment"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="EDD: 10 Feb 2026"
                                    android:textColor="@android:color/darker_gray"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- EXISTING PROFILE BUTTONS -->
                            <LinearLayout
                                android:id="@+id/profile_buttons_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@color/bottom_nav_bar_background"
                                android:gravity="start"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/hh_prof"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/round_button"
                                    android:onClick="onClick"
                                    android:text="Household Profile"
                                    android:textAllCaps="false"
                                    android:textColor="@android:color/white"
                                    android:textSize="13sp" />

                                <Button
                                    android:id="@+id/pmtct_prof"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/round_button"
                                    android:onClick="onClick"
                                    android:text="@string/pmtct_services"
                                    android:textAllCaps="false"
                                    android:textColor="@android:color/white"
                                    android:textSize="13sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#739273"
                app:tabContentStart="0dp"
                app:tabGravity="fill"
                app:tabIndicatorColor="#E2E363"
                app:tabIndicatorHeight="4dp"
                app:tabMaxWidth="0dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="@color/white"
                app:tabTextAppearance="@style/CustomFontTextViewStyle.tabIndicator.sub.white" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- MAIN CONTENT -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/collapsing_toolbar_appbarlayout"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- MENU BAR (Mother & Child actions as small professional chips) -->
        <LinearLayout
            android:id="@+id/menu_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/fabx"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Mother actions -->

            <RelativeLayout
                android:id="@+id/mother_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/callFab3"
                    android:background="@drawable/bg_mother_action_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/add_mother"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Mother"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFab3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/baseline_mode_edit_24" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mother_anc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/mother_anc_fab"
                    android:background="@drawable/bg_mother_action_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/mother_anc_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mother ANC"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mother_anc_fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mother_longitudinal_follow_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/mother_longitudinal_follow_up_fab"
                    android:background="@drawable/bg_mother_action_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/mother_longitudinal_follow_up_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mother Longitudinal Follow Up"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mother_longitudinal_follow_up_fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mother_delivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/mother_delivery_fab"
                    android:background="@drawable/bg_mother_action_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/mother_delivery_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mother Delivery"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mother_delivery_fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <!-- Child actions -->

            <RelativeLayout
                android:id="@+id/child_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/callFab2"
                    android:background="@drawable/bg_child_action_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/add_child"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Child"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/callFab2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mother_postnatal_care"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/mother_postnatal_care_fab"
                    android:background="@drawable/bg_mother_action_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/mother_postnatal_care_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mother Postnatal Care"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mother_postnatal_care_fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mother_outcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:onClick="onClick"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/mother_outcome_fab"
                    android:background="@drawable/bg_mother_action_chip"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minWidth="80dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/mother_outcome_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mother Outcome"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </RelativeLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mother_outcome_fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:backgroundTint="@color/white"
                    app:fabSize="mini"
                    app:srcCompat="@android:drawable/ic_input_add" />

            </RelativeLayout>

        </LinearLayout>

        <!-- MAIN FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:onClick="onClick"
            android:tint="@android:color/white"
            app:backgroundTint="@color/text_black"
            app:fabSize="normal"
            app:srcCompat="@drawable/baseline_mode_edit_24" />

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
