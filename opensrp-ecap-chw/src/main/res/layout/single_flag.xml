<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="0dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Severity accent strip (colored by status) -->
        <View
            android:id="@+id/flag_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Header (tap to expand/collapse) -->
            <LinearLayout
                android:id="@+id/flag_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="11dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/flag_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text_black"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Jane Banda" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/flag_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Active"
                            tools:textColor="#2E7D32" />

                        <TextView
                            android:id="@+id/flag_meta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/light_grey_text"
                            android:textSize="12sp"
                            tools:text=" · VCA 12345 · 14 Jun" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/flag_toggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/flag_expand_toggle"
                    android:src="@drawable/baseline_expand_more_24"
                    app:tint="@color/light_grey_text" />
            </LinearLayout>

            <!-- Collapsible detail (hidden until expanded) -->
            <LinearLayout
                android:id="@+id/flag_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="8dp"
                    android:background="#EEEEEE" />

                <include
                    layout="@layout/flag_field_row"
                    android:id="@+id/row_household_id" />

                <include
                    layout="@layout/flag_field_row"
                    android:id="@+id/row_vca_id" />

                <include
                    layout="@layout/flag_field_row"
                    android:id="@+id/row_caregiver_name" />

                <include
                    layout="@layout/flag_field_row"
                    android:id="@+id/row_facility" />

                <include
                    layout="@layout/flag_field_row"
                    android:id="@+id/row_caseworker_name" />

                <include
                    layout="@layout/flag_field_row"
                    android:id="@+id/row_caseworker_phone" />

                <include
                    layout="@layout/flag_field_row"
                    android:id="@+id/row_verifier" />

                <include
                    layout="@layout/flag_field_row"
                    android:id="@+id/row_comment" />

                <TextView
                    android:id="@+id/flag_open_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Open CA Profile ›" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
