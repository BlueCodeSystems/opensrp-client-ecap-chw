<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Calendar body: frames this as a monthly service record, not a generic checkmark -->
    <path
        android:name="calendar_outline"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6,5.4
                          L18,5.4
                          A1.6,1.6 0 0 1 19.6,7
                          L19.6,18
                          A1.6,1.6 0 0 1 18,19.6
                          L6,19.6
                          A1.6,1.6 0 0 1 4.4,18
                          L4.4,7
                          A1.6,1.6 0 0 1 6,5.4
                          Z" />

    <!-- Header band divider -->
    <path
        android:name="calendar_header_divider"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M4.4,9.4 L19.6,9.4" />

    <!-- Hanger tabs -->
    <path
        android:name="calendar_tab_left"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M8,3.8 L8,6.6" />

    <path
        android:name="calendar_tab_right"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M16,3.8 L16,6.6" />

    <!-- This month's service marked complete -->
    <path
        android:name="calendar_checkmark"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M8.6,14.2 L10.7,16.3 L15.4,11.6" />

</vector>
