<?xml version="1.0" encoding="utf-8"?>
<!-- Primary button on the login, PIN and set-PIN screens -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/login_button_ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/login_button_disabled" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/login_button_pressed" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/login_button" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
