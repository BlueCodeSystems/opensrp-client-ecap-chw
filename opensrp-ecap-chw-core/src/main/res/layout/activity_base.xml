<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <RelativeLayout
        android:id="@+id/nav_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"></RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="@dimen/nav_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nav_drawer_bg"
        android:fitsSystemWindows="false"
        app:theme="@style/NavigationDrawerStyle">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="false">

            <!-- Header: partner logos on white, then the app name and the signed-in user as text -->
            <LinearLayout
                android:id="@+id/rlLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:background="@color/nav_header_bg"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/nav_partner_logos"
                    android:scaleType="fitStart"
                    android:src="@drawable/iccms_partner_logos" />

                <!-- App name; NavigationMenu sets its text -->
                <TextView
                    android:id="@+id/tvLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nav_app_name"
                    android:textColor="@color/nav_header_title"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_app_full_name"
                    android:textColor="@color/nav_header_subtitle"
                    android:textSize="12sp" />

                <!-- Signed-in user and facility; NavigationMenu fills it -->
                <TextView
                    android:id="@+id/tvNavUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/nav_header_accent"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Brand-blue rule between the white header and the navy menu -->
            <View
                android:id="@+id/vDiv1"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_below="@+id/rlLogo"
                android:background="@color/nav_header_accent" />

            <!-- Scrolls the whole menu (registers + actions) between the header and the sync bar -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/vDivSync"
                android:layout_below="@+id/vDiv1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/rlMid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/tvRegisters"
                        style="@style/NavSectionLabel"
                        android:text="@string/nav_registers" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <View
                        android:id="@+id/vDiv2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/nav_divider" />

                    <TextView
                        style="@style/NavSectionLabel"
                        android:text="@string/nav_more" />

                    <RelativeLayout
                        android:id="@+id/rlReferralNotification"
                        style="@style/NavActionRow"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivIconReferralNotification"
                            style="@style/NavActionIcon"
                            android:src="@mipmap/sidemenu_referrals" />

                        <TextView
                            android:id="@+id/tvReferralNotification"
                            style="@style/NavActionText"
                            android:layout_toEndOf="@+id/ivIconReferralNotification"
                            android:text="@string/updates" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlServiceReport"
                        style="@style/NavActionRow"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivIconServiceReport"
                            style="@style/NavActionIcon"
                            android:src="@drawable/sidemenu_service_activity" />

                        <TextView
                            android:id="@+id/tvServiceReport"
                            style="@style/NavActionText"
                            android:layout_toEndOf="@+id/ivIconServiceReport"
                            android:text="@string/service_activity" />

                    </RelativeLayout>

                    <!-- Shown only when the app registers TRAINING_ATTENDANCE_ACTIVITY -->
                    <RelativeLayout
                        android:id="@+id/rlTrainingAttendance"
                        style="@style/NavActionRow"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivIconTrainingAttendance"
                            style="@style/NavActionIcon"
                            android:src="@drawable/ic_nav_training" />

                        <TextView
                            android:id="@+id/tvTrainingAttendance"
                            style="@style/NavActionText"
                            android:layout_toEndOf="@+id/ivIconTrainingAttendance"
                            android:text="@string/nav_training_attendance" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlIconStockReport"
                        style="@style/NavActionRow"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivIconStockReport"
                            style="@style/NavActionIcon"
                            app:srcCompat="@drawable/sidemenu_stock_mgmt" />

                        <TextView
                            android:id="@+id/tvStockReport"
                            style="@style/NavActionText"
                            android:layout_toEndOf="@+id/ivIconStockReport"
                            android:text="@string/stock_usage_report" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlIconResponders"
                        style="@style/NavActionRow"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivIconResponders"
                            style="@style/NavActionIcon"
                            app:srcCompat="@drawable/community_responders" />

                        <TextView
                            android:id="@+id/tvResponders"
                            style="@style/NavActionText"
                            android:layout_toEndOf="@+id/ivIconResponders"
                            android:text="@string/community_responders" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlIconLang"
                        style="@style/NavActionRow">

                        <ImageView
                            android:id="@+id/ivIconLang"
                            style="@style/NavActionIcon"
                            app:srcCompat="@drawable/ic_nav_language" />

                        <TextView
                            android:id="@+id/tvLang"
                            style="@style/NavActionText"
                            android:layout_toEndOf="@+id/ivIconLang"
                            android:text="English" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlIconDevice"
                        style="@style/NavActionRow">

                        <ImageView
                            android:id="@+id/ivIconDevice"
                            style="@style/NavActionIcon"
                            app:srcCompat="@drawable/ic_nav_device_share" />

                        <TextView
                            android:id="@+id/tvDeviceToDevice"
                            style="@style/NavActionText"
                            android:layout_toEndOf="@+id/ivIconDevice"
                            android:text="@string/device_to_device" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlLogout"
                        style="@style/NavActionRow">

                        <ImageView
                            android:id="@+id/ivLogout"
                            style="@style/NavActionIcon"
                            app:srcCompat="@drawable/ic_nav_logout" />

                        <TextView
                            android:id="@+id/tvLogout"
                            style="@style/NavActionText"
                            android:layout_toEndOf="@+id/ivLogout"
                            android:text="@string/log_out_as" />

                    </RelativeLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <View
                android:id="@+id/vDivSync"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_above="@+id/rlSync"
                android:background="@color/nav_divider" />

            <!-- Sync bar, pinned to the bottom -->
            <RelativeLayout
                android:id="@+id/rlSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="@color/nav_sync_bg"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <RelativeLayout
                    android:id="@+id/rlIconSync"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:id="@+id/ivSyncIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/nav_sync"
                        android:focusable="true"
                        android:padding="4dp"
                        app:srcCompat="@mipmap/sidemenu_sync"
                        app:tint="@color/nav_text" />

                    <ProgressBar
                        android:id="@+id/pbSync"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/nav_text" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@+id/rlIconSync"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/nav_sync"
                        android:textColor="@color/nav_text"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSyncTimeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nav_last"
                            android:textColor="@color/nav_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvSyncTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/nav_last_sync_time"
                            android:textColor="@color/nav_text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>
        </RelativeLayout>

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
